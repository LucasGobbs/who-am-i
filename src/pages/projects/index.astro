---
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectEntryCard from "../../components/ProjectEntryCard.astro";
import InterestFilter from "../../components/InterestFilter.astro";
import { getSortedProjects } from "../../lib/projects";
import { INTERESTS, SITE_AUTHOR, type Interest } from "../../consts";

const requested = Astro.url.searchParams.get("i") as Interest | null;
const validIds = new Set<Interest>(INTERESTS.map((i) => i.id));
const current: "all" | Interest =
  requested && validIds.has(requested) ? requested : "all";

const all = await getSortedProjects();

const byYear = new Map<number, typeof all>();
for (const p of all) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<PageLayout
  title={`Projects — ${SITE_AUTHOR}`}
  description="Things I have built."
>
  <p class="label" style="margin: 0 0 0.5rem;">Work</p>
  <h1 style="margin: 0 0 var(--gap-sm);">Projects</h1>
  <p style="color: var(--ink-mute); margin: 0 0 var(--gap-lg); font-size: 0.98rem;">
    Things I have built.
  </p>

  <InterestFilter current={current} basePath={`${import.meta.env.BASE_URL}projects`} />

  <style>
    .year-heading {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ink-mute);
      letter-spacing: 0.06em;
      margin: 0 0 var(--gap-md);
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--paper-edge);
    }

    .year-section {
      margin: var(--gap-xl) 0;
    }

    .year-cards {
      display: flex;
      flex-direction: column;
      gap: var(--gap-md);
    }

    /* Larger screens: wider layout, generous card gaps */
    @media (min-width: 1024px) {
      .year-heading {
        font-size: 0.9rem;
        letter-spacing: 0.07em;
        margin-bottom: var(--gap-lg);
        padding-bottom: 0.5rem;
      }

      .year-section {
        margin: var(--gap-xxl) 0;
      }

      .year-cards {
        gap: var(--gap-lg);
      }
    }

    @media (min-width: 1440px) {
      .year-heading {
        font-size: 0.92rem;
      }

      .year-cards {
        gap: calc(var(--gap-lg) + 0.25rem);
      }
    }
  </style>

  <div data-interest-list class="project-list">
    {
      years.map((year) => (
        <section class="year-section">
          <h2 class="year-heading">
            {year}
          </h2>
          <div class="year-cards">
            {byYear.get(year)!.map((entry) => (
              <div
                data-interest-item
                data-interest={entry.data.interest ?? "development"}
                hidden={current !== "all" && entry.data.interest !== current ? "" : undefined}
              >
                <ProjectEntryCard entry={entry} />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</PageLayout>
