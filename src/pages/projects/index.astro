---
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectEntryCard from "../../components/ProjectEntryCard.astro";
import InterestFilter from "../../components/InterestFilter.astro";
import { getSortedProjects } from "../../lib/projects";
import { INTERESTS, SITE_AUTHOR, type Interest } from "../../consts";

const requested = Astro.url.searchParams.get("i") as Interest | null;
const validIds = new Set<Interest>(INTERESTS.map((i) => i.id));
const current: "all" | Interest =
  requested && validIds.has(requested) ? requested : "all";

const all = await getSortedProjects();

const byYear = new Map<number, typeof all>();
for (const p of all) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<PageLayout
  title={`Projects — ${SITE_AUTHOR}`}
  description="Things I have built."
>
  <p class="label mb-2">Work</p>
  <h1 class="mb-4">Projects</h1>
  <p class="mb-8 text-base text-stone-500">
    Things I have built.
  </p>

  <InterestFilter current={current} basePath={`${import.meta.env.BASE_URL}projects`} />

  <div data-interest-list class="project-list">
    {
      years.map((year) => (
        <section class="my-10 lg:my-16">
          <h2 class="mb-6 border-b border-stone-200 pb-2 font-mono text-sm font-medium tracking-wider text-stone-500 lg:mb-8 lg:text-base xl:text-lg">
            {year}
          </h2>
          <div class="flex flex-col gap-6 lg:gap-8 xl:gap-10">
            {byYear.get(year)!.map((entry) => (
              <div
                data-interest-item
                data-interest={entry.data.interest ?? "development"}
                hidden={current !== "all" && entry.data.interest !== current ? "" : undefined}
              >
                <ProjectEntryCard entry={entry} />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</PageLayout>
