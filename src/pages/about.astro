---
import PageLayout from "../layouts/PageLayout.astro";
import { ABOUT_BIO, SITE_AUTHOR, SITE_ROLE, SITE_LOCATION } from "../consts";
---

<PageLayout
  title={`About — ${SITE_AUTHOR}`}
  description="A longer note about who I am and what I care about."
>
  <p class="label" style="margin: 0 0 0.5rem;">Colophon</p>
  <h1 style="margin: 0 0 var(--gap-lg);">About</h1>
  <p style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-mute); margin: 0 0 var(--gap-lg); letter-spacing: 0.03em;">
    {SITE_ROLE} · {SITE_LOCATION}
  </p>
  {ABOUT_BIO.map((para) => <p style="margin: var(--gap-md) 0; line-height: 1.7; color: var(--ink-soft);">{para}</p>)}
</PageLayout>
