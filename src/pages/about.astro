---
import PageLayout from "../layouts/PageLayout.astro";
import { ABOUT_BIO, SITE_AUTHOR, SITE_ROLE, SITE_LOCATION } from "../consts";
---

<PageLayout
  title={`About — ${SITE_AUTHOR}`}
  description="A longer note about who I am and what I care about."
>
  <p class="label mb-2">Colophon</p>
  <h1 class="mb-8">About</h1>
  <p class="mb-8 font-mono text-sm tracking-wide text-stone-500">
    {SITE_ROLE} · {SITE_LOCATION}
  </p>
  {ABOUT_BIO.map((para) => <p class="my-6 leading-7 text-stone-700">{para}</p>)}
</PageLayout>
