---
import PageLayout from "../layouts/PageLayout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import {
  EXPERIENCES,
  SKILLS,
  EDUCATION,
  CERTIFICATES,
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_LOCATION,
  SOCIAL_LINKS,
} from "../consts";

const base = import.meta.env.BASE_URL;
const email = SOCIAL_LINKS.find((s) => s.label === "Email")?.href ?? "";
---

<PageLayout
  title={`Resume — ${SITE_AUTHOR}`}
  description="Professional experience, skills, education, and certifications."
>
  <section class="resume-hero mb-[var(--gap-xxl)]">
    <p class="kicker mb-4">Curriculum Vitae</p>
    <h1 class="mb-[0.4rem] text-[length:var(--step-display)] leading-[0.98]">
      {SITE_AUTHOR}
    </h1>
    <p class="mb-[var(--gap-md)] font-[family-name:var(--font-mono)] text-[0.88rem] uppercase tracking-[0.05em] text-[var(--ink-mute)]">
      {SITE_ROLE} · {SITE_LOCATION}
    </p>
    <p class="mt-[var(--gap-md)] max-w-[58ch] text-[1.08rem] leading-[1.65] text-[var(--ink-soft)]">
      Backend and integrations developer with 5+ years across DevOps, frontend,
      and platform tooling. I care about boring infrastructure, observable
      systems, and code that survives the person who wrote it.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">✦ ✦ ✦</div>

  <section>
    <p class="section-num">01</p>
    <h2 class="mb-[var(--gap-lg)]">Experience</h2>
    <ExperienceTimeline experiences={EXPERIENCES} />
  </section>

  <section>
    <p class="section-num">02</p>
    <h2 class="mb-[var(--gap-lg)]">Skills</h2>
    <dl class="grid gap-[var(--gap-md)]">
      {
        SKILLS.map((group) => (
          <div class="grid grid-cols-[9rem_1fr] items-baseline gap-[var(--gap-md)] border-b border-[var(--paper-edge)] pb-[var(--gap-md)]">
            <dt class="label font-semibold text-[var(--accent)]">
              {group.group}
            </dt>
            <dd class="text-[0.98rem] leading-[1.55] text-[var(--ink-soft)]">
              {group.items.join("  ·  ")}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <p class="section-num">03</p>
    <h2 class="mb-[var(--gap-lg)]">Education</h2>
    <ul class="list-none p-0">
      {
        EDUCATION.map((edu) => (
          <li class="my-[var(--gap-md)] border-b border-[var(--paper-edge)] pb-[var(--gap-md)]">
            <p class="label mb-[0.3rem] font-semibold text-[var(--accent)]">
              {edu.startYear} – {edu.endYear ?? "present"}
            </p>
            <p class="font-[family-name:var(--font-display)] text-[1.15rem] leading-[1.25] text-[var(--ink)]">
              {edu.degree}
            </p>
            <p class="mt-[0.2rem] font-[family-name:var(--font-mono)] text-[0.8rem] tracking-[0.03em] text-[var(--ink-mute)]">
              {edu.institution}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">04</p>
    <h2 class="mb-[var(--gap-lg)]">Certificates</h2>
    <ul class="list-none p-0">
      {
        CERTIFICATES.map((cert) => (
          <li class="my-[var(--gap-sm)] flex flex-wrap items-baseline gap-[var(--gap-md)] border-b border-[var(--paper-edge)] pb-[var(--gap-sm)]">
            <span class="label min-w-[3.5rem] shrink-0 font-semibold text-[var(--accent)]">
              {cert.year}
            </span>
            <span class="min-w-0 flex-1">
              <span class="font-[family-name:var(--font-display)] text-[1.05rem] text-[var(--ink)]">
                {cert.name}
              </span>
              <span class="ml-2 font-[family-name:var(--font-mono)] text-[0.85rem] tracking-[0.03em] text-[var(--ink-mute)]">
                {cert.issuer}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">05</p>
    <h2 class="mb-[var(--gap-lg)]">Contact</h2>
    <p class="mb-[var(--gap-md)] text-[1rem] text-[var(--ink-soft)]">
      Reach out for collaborations, questions, or just to say hello.
    </p>
    {
      email && (
        <p>
          <a
            href={email.startsWith("mailto:") ? email : `mailto:${email}`}
            class="inline-block rounded-[var(--radius-pill)] border border-[var(--ink)] px-[1.1rem] py-2 font-[family-name:var(--font-mono)] text-[0.9rem] tracking-[0.04em] text-[var(--ink)] no-underline transition-[background,color] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:bg-[var(--ink)] hover:text-[var(--paper)]"
          >
            {email.replace(/^mailto:/, "")} →
          </a>
        </p>
      )
    }
  </section>
</PageLayout>
