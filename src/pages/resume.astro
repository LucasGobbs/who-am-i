---
import PageLayout from "../layouts/PageLayout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import {
  EXPERIENCES,
  SKILLS,
  EDUCATION,
  CERTIFICATES,
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_LOCATION,
  SOCIAL_LINKS,
} from "../consts";

const base = import.meta.env.BASE_URL;
const email = SOCIAL_LINKS.find((s) => s.label === "Email")?.href ?? "";
---

<PageLayout
  title={`Resume — ${SITE_AUTHOR}`}
  description="Professional experience, skills, education, and certifications."
>
  <section class="resume-hero" style="margin: 0 0 var(--gap-xxl);">
    <p class="kicker" style="margin: 0 0 1rem;">Curriculum Vitae</p>
    <h1 style="margin: 0 0 0.4rem; font-size: var(--step-display); line-height: 0.98;">
      {SITE_AUTHOR}
    </h1>
    <p style="font-family: var(--font-mono); font-size: 0.88rem; color: var(--ink-mute); margin: 0 0 var(--gap-md); letter-spacing: 0.05em; text-transform: uppercase;">
      {SITE_ROLE} · {SITE_LOCATION}
    </p>
    <p style="font-size: 1.08rem; line-height: 1.65; max-width: 58ch; color: var(--ink-soft); margin: var(--gap-md) 0 0;">
      Backend and integrations developer with 5+ years across DevOps, frontend,
      and platform tooling. I care about boring infrastructure, observable
      systems, and code that survives the person who wrote it.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">✦ ✦ ✦</div>

  <section>
    <p class="section-num">01</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Experience</h2>
    <ExperienceTimeline experiences={EXPERIENCES} />
  </section>

  <section>
    <p class="section-num">02</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Skills</h2>
    <dl style="margin: 0; display: grid; gap: var(--gap-md);">
      {
        SKILLS.map((group) => (
          <div style="display: grid; grid-template-columns: 9rem 1fr; gap: var(--gap-md); align-items: baseline; padding-bottom: var(--gap-md); border-bottom: 1px solid var(--paper-edge);">
            <dt class="label" style="margin: 0; color: var(--accent); font-weight: 600;">
              {group.group}
            </dt>
            <dd style="margin: 0; font-size: 0.98rem; color: var(--ink-soft); line-height: 1.55;">
              {group.items.join("  ·  ")}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <p class="section-num">03</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Education</h2>
    <ul style="list-style: none; padding: 0; margin: 0;">
      {
        EDUCATION.map((edu) => (
          <li style="margin: var(--gap-md) 0; padding-bottom: var(--gap-md); border-bottom: 1px solid var(--paper-edge);">
            <p class="label" style="margin: 0 0 0.3rem; color: var(--accent); font-weight: 600;">
              {edu.startYear} – {edu.endYear ?? "present"}
            </p>
            <p style="margin: 0; font-family: var(--font-display); font-size: 1.15rem; color: var(--ink); line-height: 1.25;">
              {edu.degree}
            </p>
            <p style="margin: 0.2rem 0 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-mute); letter-spacing: 0.03em;">
              {edu.institution}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">04</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Certificates</h2>
    <ul style="list-style: none; padding: 0; margin: 0;">
      {
        CERTIFICATES.map((cert) => (
          <li style="margin: var(--gap-sm) 0; display: flex; gap: var(--gap-md); align-items: baseline; flex-wrap: wrap; padding-bottom: var(--gap-sm); border-bottom: 1px solid var(--paper-edge);">
            <span class="label" style="color: var(--accent); flex-shrink: 0; min-width: 3.5rem; font-weight: 600;">
              {cert.year}
            </span>
            <span style="flex: 1; min-width: 0;">
              <span style="font-family: var(--font-display); font-size: 1.05rem; color: var(--ink);">
                {cert.name}
              </span>
              <span style="color: var(--ink-mute); font-size: 0.85rem; margin-left: 0.5rem; font-family: var(--font-mono); letter-spacing: 0.03em;">
                {cert.issuer}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">05</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Contact</h2>
    <p style="margin: 0 0 var(--gap-md); color: var(--ink-soft); font-size: 1rem;">
      Reach out for collaborations, questions, or just to say hello.
    </p>
    {
      email && (
        <p style="margin: 0;">
          <a
            href={email.startsWith("mailto:") ? email : `mailto:${email}`}
            style="font-family: var(--font-mono); font-size: 0.9rem; letter-spacing: 0.04em; color: var(--ink); text-decoration: none; border: 1px solid var(--ink); padding: 0.5rem 1.1rem; border-radius: var(--radius-pill); transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);"
            class="contact-button"
          >
            {email.replace(/^mailto:/, "")} →
          </a>
        </p>
      )
    }
  </section>
</PageLayout>

<style>
  .contact-button:hover {
    background: var(--ink);
    color: var(--paper) !important;
  }
</style>