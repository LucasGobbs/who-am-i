---
import PageLayout from "../layouts/PageLayout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import {
  EXPERIENCES,
  SKILLS,
  EDUCATION,
  CERTIFICATES,
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_LOCATION,
  SOCIAL_LINKS,
} from "../consts";

const base = import.meta.env.BASE_URL;
const email = SOCIAL_LINKS.find((s) => s.label === "Email")?.href ?? "";
---

<PageLayout
  title={`Resume — ${SITE_AUTHOR}`}
  description="Professional experience, skills, education, and certifications."
>
  <section class="resume-hero mb-16">
    <p class="kicker mb-4">Curriculum Vitae</p>
    <h1 class="mb-2 font-serif text-4xl leading-none">
      {SITE_AUTHOR}
    </h1>
    <p class="mb-6 font-mono text-sm uppercase tracking-wider text-stone-500">
      {SITE_ROLE} · {SITE_LOCATION}
    </p>
    <p class="mt-6 max-w-2xl text-lg leading-7 text-stone-700">
      Backend and integrations developer with 5+ years across DevOps, frontend,
      and platform tooling. I care about boring infrastructure, observable
      systems, and code that survives the person who wrote it.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">✦ ✦ ✦</div>

  <section>
    <p class="section-num">01</p>
    <h2 class="mb-8">Experience</h2>
    <ExperienceTimeline experiences={EXPERIENCES} />
  </section>

  <section>
    <p class="section-num">02</p>
    <h2 class="mb-8">Skills</h2>
    <dl class="grid gap-6">
      {
        SKILLS.map((group) => (
          <div class="grid grid-cols-4 items-baseline gap-6 border-b border-stone-200 pb-6">
            <dt class="label font-semibold text-orange-600">
              {group.group}
            </dt>
            <dd class="col-span-3 text-base leading-6 text-stone-700">
              {group.items.join("  ·  ")}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <p class="section-num">03</p>
    <h2 class="mb-8">Education</h2>
    <ul class="list-none p-0">
      {
        EDUCATION.map((edu) => (
          <li class="my-6 border-b border-stone-200 pb-6">
            <p class="label mb-1 font-semibold text-orange-600">
              {edu.startYear} – {edu.endYear ?? "present"}
            </p>
            <p class="font-serif text-lg leading-6 text-stone-900">
              {edu.degree}
            </p>
            <p class="mt-1 font-mono text-xs tracking-wide text-stone-500">
              {edu.institution}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">04</p>
    <h2 class="mb-8">Certificates</h2>
    <ul class="list-none p-0">
      {
        CERTIFICATES.map((cert) => (
          <li class="my-4 flex flex-wrap items-baseline gap-6 border-b border-stone-200 pb-4">
            <span class="label min-w-14 shrink-0 font-semibold text-orange-600">
              {cert.year}
            </span>
            <span class="min-w-0 flex-1">
              <span class="font-serif text-base text-stone-900">
                {cert.name}
              </span>
              <span class="ml-2 font-mono text-sm tracking-wide text-stone-500">
                {cert.issuer}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <p class="section-num">05</p>
    <h2 class="mb-8">Contact</h2>
    <p class="mb-6 text-base text-stone-700">
      Reach out for collaborations, questions, or just to say hello.
    </p>
    {
      email && (
        <p>
          <a
            href={email.startsWith("mailto:") ? email : `mailto:${email}`}
            class="inline-block rounded-full border border-stone-900 px-4 py-2 font-mono text-sm tracking-wide text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-stone-900 hover:text-stone-50"
          >
            {email.replace(/^mailto:/, "")} →
          </a>
        </p>
      )
    }
  </section>
</PageLayout>
