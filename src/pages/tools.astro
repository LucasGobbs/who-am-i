---
import PageLayout from "../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../consts";

const base = import.meta.env.BASE_URL;

export type Tool = {
  name: string;
  description: string;
  href: string;
  kind: "static" | "interactive";
  tag?: string;
};

const TOOLS: Tool[] = [
  {
    name: "QR Code Generator",
    description:
      "Paste a URL or text, get a scannable QR code. Runs entirely in your browser, no server roundtrip.",
    href: `${base}tools/qr/`,
    kind: "interactive",
    tag: "Generator",
  },
  {
    name: "Base64 Encode / Decode",
    description:
      "Convert text to Base64 and back. Handles UTF-8 correctly, client-side only.",
    href: `${base}tools/base64/`,
    kind: "interactive",
    tag: "Converter",
  },
  {
    name: "Unix Time Converter",
    description:
      "Convert between Unix timestamps and human-readable dates across timezones.",
    href: `${base}tools/unix-time/`,
    kind: "interactive",
    tag: "Converter",
  },
];
---

<PageLayout
  title={`Tools — ${SITE_AUTHOR}`}
  description="Small, single-purpose browser tools. No servers, no tracking."
>
  <p class="label mb-2">Workshop</p>
  <h1 class="mb-[var(--gap-lg)]">Tools</h1>
  <p class="mb-[var(--gap-xl)] max-w-[56ch] text-[0.98rem] text-[var(--ink-mute)]">
    Small, single-purpose browser tools. Each one does one thing, runs client-side,
    and has no backend. Built mostly to scratch my own itches.
  </p>

  <ul class="grid list-none gap-[var(--gap-md)] p-0">
    {
      TOOLS.map((t) => (
        <li>
          <a
            href={t.href}
            class="tool-card block rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] p-[var(--gap-lg)] text-inherit no-underline transition-[border-color,background] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:border-[var(--ink-mute)] hover:bg-[var(--paper)]"
          >
            <div class="mb-[0.4rem] flex items-baseline justify-between gap-[var(--gap-sm)]">
              <h2 class="font-[family-name:var(--font-display)] text-[length:var(--step-title)] text-[var(--ink)]">
                {t.name}
              </h2>
              {t.tag && (
                <span class="rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper)] px-[0.55rem] py-[0.15rem] font-[family-name:var(--font-mono)] text-[0.7rem] uppercase tracking-[0.05em] text-[var(--ink-faint)]">
                  {t.tag}
                </span>
              )}
            </div>
            <p class="text-[0.95rem] leading-[1.55] text-[var(--ink-soft)]">
              {t.description}
            </p>
            <p class="mt-[var(--gap-sm)] font-[family-name:var(--font-mono)] text-[0.76rem] tracking-[0.04em] text-[var(--ink-mute)]">
              {t.kind === "interactive" ? "client-side · runs in browser" : "static"}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-[var(--gap-xl)] font-[family-name:var(--font-mono)] text-[0.75rem] tracking-[0.04em] text-[var(--ink-faint)]">
    More tools added as I need them. Suggestions welcome via the links in the footer.
  </p>
</PageLayout>
