---
import PageLayout from "../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../consts";

const base = import.meta.env.BASE_URL;

export type Tool = {
  name: string;
  description: string;
  href: string;
  kind: "static" | "interactive";
  tag?: string;
};

const TOOLS: Tool[] = [
  {
    name: "QR Code Generator",
    description:
      "Paste a URL or text, get a scannable QR code. Runs entirely in your browser, no server roundtrip.",
    href: `${base}tools/qr/`,
    kind: "interactive",
    tag: "Generator",
  },
  {
    name: "Base64 Encode / Decode",
    description:
      "Convert text to Base64 and back. Handles UTF-8 correctly, client-side only.",
    href: `${base}tools/base64/`,
    kind: "interactive",
    tag: "Converter",
  },
  {
    name: "Unix Time Converter",
    description:
      "Convert between Unix timestamps and human-readable dates across timezones.",
    href: `${base}tools/unix-time/`,
    kind: "interactive",
    tag: "Converter",
  },
  {
    name: "Syntax Converter",
    description:
      "Convert custom shorthand syntax to MDX components. Write $http > GET > /route and get component markup.",
    href: `${base}tools/syntax-converter/`,
    kind: "interactive",
    tag: "Converter",
  },
];
---

<PageLayout
  title={`Tools — ${SITE_AUTHOR}`}
  description="Small, single-purpose browser tools. No servers, no tracking."
>
  <p class="label mb-2">Workshop</p>
  <h1 class="mb-8">Tools</h1>
  <p class="mb-10 max-w-2xl text-base text-stone-500">
    Small, single-purpose browser tools. Each one does one thing, runs client-side,
    and has no backend. Built mostly to scratch my own itches.
  </p>

  <ul class="grid list-none gap-6 p-0">
    {
      TOOLS.map((t) => (
        <li>
          <a
            href={t.href}
            class="tool-card block rounded-lg border border-stone-200 bg-stone-100 p-8 text-inherit no-underline transition-colors duration-150 ease-out hover:border-stone-500 hover:bg-stone-50"
          >
            <div class="mb-2 flex items-baseline justify-between gap-4">
              <h2 class="font-serif text-2xl text-stone-900">
                {t.name}
              </h2>
              {t.tag && (
                <span class="rounded-full border border-stone-200 bg-stone-50 px-2 py-0.5 font-mono text-xs uppercase tracking-wider text-stone-400">
                  {t.tag}
                </span>
              )}
            </div>
            <p class="text-base leading-6 text-stone-700">
              {t.description}
            </p>
            <p class="mt-4 font-mono text-xs tracking-wide text-stone-500">
              {t.kind === "interactive" ? "client-side · runs in browser" : "static"}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 font-mono text-xs tracking-wide text-stone-400">
    More tools added as I need them. Suggestions welcome via the links in the footer.
  </p>
</PageLayout>
