---
import PageLayout from "../../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../../consts";
---

<PageLayout
  title={`Base64 Encode / Decode — ${SITE_AUTHOR}`}
  description="Convert text to Base64 and back. UTF-8 safe. Runs in your browser."
>
  <p class="label mb-2">
    <a href={`${import.meta.env.BASE_URL}tools/`} class="text-[var(--ink-mute)] no-underline">← Tools</a>
  </p>
  <h1 class="mb-[var(--gap-lg)]">Base64 Encode / Decode</h1>

  <div class="grid max-w-[56ch] gap-[var(--gap-md)]">
    <div>
      <label for="b64-input" class="mb-[var(--gap-xs)] block font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.04em] text-[var(--ink-mute)]">
        Input
      </label>
      <textarea id="b64-input" rows="4" placeholder="Type text to encode, or Base64 to decode" class="box-border w-full resize-y rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper)] px-[var(--gap-md)] py-[var(--gap-sm)] font-[family-name:var(--font-mono)] text-[0.9rem] text-[var(--ink)]"></textarea>
    </div>

    <div class="flex gap-[var(--gap-sm)]">
      <button id="b64-encode" type="button" class="cursor-pointer rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] px-[0.9rem] py-[0.4rem] font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.05em] text-[var(--ink-soft)] transition-[color,border-color] duration-[var(--dur-fast)] ease-[var(--ease-out)]">Encode →</button>
      <button id="b64-decode" type="button" class="cursor-pointer rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] px-[0.9rem] py-[0.4rem] font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.05em] text-[var(--ink-soft)] transition-[color,border-color] duration-[var(--dur-fast)] ease-[var(--ease-out)]">← Decode</button>
      <button id="b64-swap" type="button" class="cursor-pointer rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper)] px-[0.9rem] py-[0.4rem] font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.05em] text-[var(--ink-mute)] transition-colors duration-[var(--dur-fast)] ease-[var(--ease-out)]">Swap ↑↓</button>
    </div>

    <div>
      <label for="b64-output" class="mb-[var(--gap-xs)] block font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.04em] text-[var(--ink-mute)]">
        Output
      </label>
      <textarea id="b64-output" rows="4" readonly class="box-border w-full resize-y rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] px-[var(--gap-md)] py-[var(--gap-sm)] font-[family-name:var(--font-mono)] text-[0.9rem] text-[var(--ink)]"></textarea>
    </div>

    <p id="b64-error" class="min-h-[1.2em] font-[family-name:var(--font-mono)] text-[0.75rem] text-[var(--accent)]"></p>
  </div>
</PageLayout>

<script is:inline>
  (() => {
    const run = () => {
      const input = document.getElementById("b64-input");
      const output = document.getElementById("b64-output");
      const err = document.getElementById("b64-error");
      const enc = document.getElementById("b64-encode");
      const dec = document.getElementById("b64-decode");
      const swap = document.getElementById("b64-swap");
      if (!input || !output || !err || !enc || !dec || !swap) return;

      const encode = () => {
        err.textContent = "";
        try {
          const bytes = new TextEncoder().encode(input.value);
          let bin = "";
          bytes.forEach((b) => bin += String.fromCharCode(b));
          output.value = btoa(bin);
        } catch (e) {
          err.textContent = "Encode failed.";
        }
      };
      const decode = () => {
        err.textContent = "";
        try {
          const bin = atob(input.value.trim());
          const bytes = new Uint8Array(bin.length);
          for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
          output.value = new TextDecoder().decode(bytes);
        } catch (e) {
          err.textContent = "Invalid Base64 input.";
          output.value = "";
        }
      };

      enc.addEventListener("click", encode);
      dec.addEventListener("click", decode);
      swap.addEventListener("click", () => {
        const a = input.value;
        input.value = output.value;
        output.value = a;
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
