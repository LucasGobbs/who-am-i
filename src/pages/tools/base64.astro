---
import PageLayout from "../../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../../consts";
---

<PageLayout
  title={`Base64 Encode / Decode — ${SITE_AUTHOR}`}
  description="Convert text to Base64 and back. UTF-8 safe. Runs in your browser."
>
  <p class="label mb-2">
    <a href={`${import.meta.env.BASE_URL}tools/`} class="text-stone-500 no-underline">← Tools</a>
  </p>
  <h1 class="mb-8">Base64 Encode / Decode</h1>

  <div class="grid max-w-2xl gap-6">
    <div>
      <label for="b64-input" class="mb-2 block font-mono text-xs uppercase tracking-wide text-stone-500">
        Input
      </label>
      <textarea id="b64-input" rows="4" placeholder="Type text to encode, or Base64 to decode" class="box-border w-full resize-y rounded-lg border border-stone-200 bg-stone-50 px-6 py-4 font-mono text-sm text-stone-900"></textarea>
    </div>

    <div class="flex gap-4">
      <button id="b64-encode" type="button" class="cursor-pointer rounded-full border border-stone-200 bg-stone-100 px-4 py-2 font-mono text-xs uppercase tracking-wider text-stone-700 transition-colors duration-150 ease-out">Encode →</button>
      <button id="b64-decode" type="button" class="cursor-pointer rounded-full border border-stone-200 bg-stone-100 px-4 py-2 font-mono text-xs uppercase tracking-wider text-stone-700 transition-colors duration-150 ease-out">← Decode</button>
      <button id="b64-swap" type="button" class="cursor-pointer rounded-full border border-stone-200 bg-stone-50 px-4 py-2 font-mono text-xs uppercase tracking-wider text-stone-500 transition-colors duration-150 ease-out">Swap ↑↓</button>
    </div>

    <div>
      <label for="b64-output" class="mb-2 block font-mono text-xs uppercase tracking-wide text-stone-500">
        Output
      </label>
      <textarea id="b64-output" rows="4" readonly class="box-border w-full resize-y rounded-lg border border-stone-200 bg-stone-100 px-6 py-4 font-mono text-sm text-stone-900"></textarea>
    </div>

    <p id="b64-error" class="min-h-5 font-mono text-xs text-orange-600"></p>
  </div>
</PageLayout>

<script is:inline>
  (() => {
    const run = () => {
      const input = document.getElementById("b64-input");
      const output = document.getElementById("b64-output");
      const err = document.getElementById("b64-error");
      const enc = document.getElementById("b64-encode");
      const dec = document.getElementById("b64-decode");
      const swap = document.getElementById("b64-swap");
      if (!input || !output || !err || !enc || !dec || !swap) return;

      const encode = () => {
        err.textContent = "";
        try {
          const bytes = new TextEncoder().encode(input.value);
          let bin = "";
          bytes.forEach((b) => bin += String.fromCharCode(b));
          output.value = btoa(bin);
        } catch (e) {
          err.textContent = "Encode failed.";
        }
      };
      const decode = () => {
        err.textContent = "";
        try {
          const bin = atob(input.value.trim());
          const bytes = new Uint8Array(bin.length);
          for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
          output.value = new TextDecoder().decode(bytes);
        } catch (e) {
          err.textContent = "Invalid Base64 input.";
          output.value = "";
        }
      };

      enc.addEventListener("click", encode);
      dec.addEventListener("click", decode);
      swap.addEventListener("click", () => {
        const a = input.value;
        input.value = output.value;
        output.value = a;
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
