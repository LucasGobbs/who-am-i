---
import PageLayout from "../../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../../consts";
---

<PageLayout
  title={`QR Code Generator — ${SITE_AUTHOR}`}
  description="Generate a QR code from any text or URL. Runs in your browser."
>
  <p class="label mb-2">
    <a href={`${import.meta.env.BASE_URL}tools/`} class="text-stone-500 no-underline">← Tools</a>
  </p>
  <h1 class="mb-8">QR Code Generator</h1>

  <label for="qr-input" class="mb-2 block font-mono text-xs uppercase tracking-wide text-stone-500">
    Text or URL
  </label>
  <textarea id="qr-input" rows="3" placeholder="https://example.com or any text" class="box-border w-full max-w-2xl resize-y rounded-lg border border-stone-200 bg-stone-50 px-6 py-4 font-mono text-sm text-stone-900"></textarea>

  <div class="my-6 flex flex-wrap items-center gap-6">
    <label for="qr-size" class="font-mono text-xs uppercase tracking-wide text-stone-500">
      Size
    </label>
    <input id="qr-size" type="range" min="128" max="512" step="32" value="256" class="accent-stone-900" />
    <span id="qr-size-val" class="min-w-14 font-mono text-xs text-stone-400">256px</span>
  </div>

  <div id="qr-output" class="my-6 inline-block min-h-32 rounded-lg border border-stone-200 bg-stone-100 p-6">
    <p class="font-mono text-xs text-stone-400">
      Type something to generate a QR code.
    </p>
  </div>

  <p class="my-6">
    <button id="qr-download" type="button" disabled class="cursor-pointer rounded-full border border-stone-200 bg-stone-50 px-4 py-2 font-mono text-xs uppercase tracking-wider text-stone-500 transition-colors duration-150 ease-out">
      Download PNG
    </button>
  </p>
</PageLayout>

<script is:inline>
  (() => {
    const run = async () => {
      const input = document.getElementById("qr-input");
      const output = document.getElementById("qr-output");
      const size = document.getElementById("qr-size");
      const sizeVal = document.getElementById("qr-size-val");
      const dl = document.getElementById("qr-download");
      if (!input || !output || !size || !sizeVal || !dl) return;

      let canvas = null;
      const emptyMessage = '<p class="font-mono text-xs text-stone-400">Type something to generate a QR code.</p>';
      const errorMessage = '<p class="font-mono text-xs text-red-600">Failed to load QR library. Check your connection.</p>';

      const render = async () => {
        const text = input.value.trim();
        const px = Number(size.value);
        sizeVal.textContent = `${px}px`;
        if (!text) {
          output.innerHTML = emptyMessage;
          dl.disabled = true;
          canvas = null;
          return;
        }
        try {
          const mod = await import("https://cdn.jsdelivr.net/npm/qrcode@1.5.4/+esm");
          canvas = document.createElement("canvas");
          canvas.width = px;
          canvas.height = px;
          canvas.className = "block h-auto max-w-full";
          await mod.toCanvas(canvas, text, { width: px, margin: 1, color: { dark: "#1a1714", light: "#f7f2e8" } });
          output.innerHTML = "";
          output.appendChild(canvas);
          dl.disabled = false;
        } catch (e) {
          output.innerHTML = errorMessage;
          dl.disabled = true;
        }
      };

      input.addEventListener("input", render);
      size.addEventListener("input", render);
      dl.addEventListener("click", () => {
        if (!canvas) return;
        const a = document.createElement("a");
        a.download = "qr-code.png";
        a.href = canvas.toDataURL("image/png");
        a.click();
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
