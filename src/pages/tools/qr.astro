---
import PageLayout from "../../layouts/PageLayout.astro";
import { SITE_AUTHOR } from "../../consts";
---

<PageLayout
  title={`QR Code Generator — ${SITE_AUTHOR}`}
  description="Generate a QR code from any text or URL. Runs in your browser."
>
  <p class="label mb-2">
    <a href={`${import.meta.env.BASE_URL}tools/`} class="text-[var(--ink-mute)] no-underline">← Tools</a>
  </p>
  <h1 class="mb-[var(--gap-lg)]">QR Code Generator</h1>

  <label for="qr-input" class="mb-[var(--gap-xs)] block font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.04em] text-[var(--ink-mute)]">
    Text or URL
  </label>
  <textarea id="qr-input" rows="3" placeholder="https://example.com or any text" class="box-border w-full max-w-[56ch] resize-y rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper)] px-[var(--gap-md)] py-[var(--gap-sm)] font-[family-name:var(--font-mono)] text-[0.9rem] text-[var(--ink)]"></textarea>

  <div class="my-[var(--gap-md)] flex flex-wrap items-center gap-[var(--gap-md)]">
    <label for="qr-size" class="font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.04em] text-[var(--ink-mute)]">
      Size
    </label>
    <input id="qr-size" type="range" min="128" max="512" step="32" value="256" class="accent-[var(--ink)]" />
    <span id="qr-size-val" class="min-w-[3.5rem] font-[family-name:var(--font-mono)] text-[0.8rem] text-[var(--ink-faint)]">256px</span>
  </div>

  <div id="qr-output" class="my-[var(--gap-md)] inline-block min-h-[128px] rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] p-[var(--gap-md)]">
    <p class="font-[family-name:var(--font-mono)] text-[0.78rem] text-[var(--ink-faint)]">
      Type something to generate a QR code.
    </p>
  </div>

  <p class="my-[var(--gap-md)]">
    <button id="qr-download" type="button" disabled class="cursor-pointer rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper)] px-[0.9rem] py-[0.4rem] font-[family-name:var(--font-mono)] text-[0.78rem] uppercase tracking-[0.05em] text-[var(--ink-mute)] transition-[color,border-color] duration-[var(--dur-fast)] ease-[var(--ease-out)]">
      Download PNG
    </button>
  </p>
</PageLayout>

<script is:inline>
  (() => {
    const run = async () => {
      const input = document.getElementById("qr-input");
      const output = document.getElementById("qr-output");
      const size = document.getElementById("qr-size");
      const sizeVal = document.getElementById("qr-size-val");
      const dl = document.getElementById("qr-download");
      if (!input || !output || !size || !sizeVal || !dl) return;

      let canvas = null;
      const emptyMessage = '<p class="font-[family-name:var(--font-mono)] text-[0.78rem] text-[var(--ink-faint)]">Type something to generate a QR code.</p>';
      const errorMessage = '<p class="font-[family-name:var(--font-mono)] text-[0.78rem] text-[var(--accent)]">Failed to load QR library. Check your connection.</p>';

      const render = async () => {
        const text = input.value.trim();
        const px = Number(size.value);
        sizeVal.textContent = `${px}px`;
        if (!text) {
          output.innerHTML = emptyMessage;
          dl.disabled = true;
          canvas = null;
          return;
        }
        try {
          const mod = await import("https://cdn.jsdelivr.net/npm/qrcode@1.5.4/+esm");
          canvas = document.createElement("canvas");
          canvas.width = px;
          canvas.height = px;
          canvas.className = "block h-auto max-w-full";
          await mod.toCanvas(canvas, text, { width: px, margin: 1, color: { dark: "#1a1714", light: "#f7f2e8" } });
          output.innerHTML = "";
          output.appendChild(canvas);
          dl.disabled = false;
        } catch (e) {
          output.innerHTML = errorMessage;
          dl.disabled = true;
        }
      };

      input.addEventListener("input", render);
      size.addEventListener("input", render);
      dl.addEventListener("click", () => {
        if (!canvas) return;
        const a = document.createElement("a");
        a.download = "qr-code.png";
        a.href = canvas.toDataURL("image/png");
        a.click();
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
