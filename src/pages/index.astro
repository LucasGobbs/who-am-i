---
import PageLayout from "../layouts/PageLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import ProjectEntryCard from "../components/ProjectEntryCard.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import {
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_LOCATION,
  EXPERIENCES,
  SITE_DESCRIPTION,
  SITE_URL,
  SOCIAL_LINKS,
} from "../consts";
import { getSortedThoughts } from "../lib/thoughts";
import { getSortedProjects } from "../lib/projects";

const thoughts = (await getSortedThoughts()).slice(0, 3);
const projects = (await getSortedProjects()).slice(0, 2);
const first = SITE_AUTHOR.charAt(0);
const rest = SITE_AUTHOR.slice(1);

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": SITE_AUTHOR,
  "url": SITE_URL,
  "jobTitle": SITE_ROLE,
  "worksFor": {
    "@type": "Organization",
    "name": EXPERIENCES[0]?.company ?? "",
  },
  "sameAs": SOCIAL_LINKS
    .filter((l) => l.href.startsWith("http"))
    .map((l) => l.href),
});
---

<PageLayout
  title={`${SITE_AUTHOR} — ${SITE_ROLE}`}
  description={SITE_DESCRIPTION}
  jsonLd={personJsonLd}
>
  <section class="hero mb-16">
    <p class="kicker mb-5">Notebook · Resume · Projects</p>
    <h1 class="mega-name text-6xl leading-none tracking-tight">
      <span class="text-orange-600">{first}</span><span>{rest}</span>
    </h1>
    <p class="mt-5 font-mono text-sm tracking-wide text-stone-500">
      {SITE_ROLE} · {SITE_LOCATION}
    </p>
    <p class="drop-cap mt-10 max-w-2xl text-lg leading-7 text-stone-700">
      Software developer with 5+ years across backend, frontend, and DevOps.
      I build integrations and care about boring, observable, maintainable
      infrastructure. This site is my resume, my projects, and a small
      notebook of thoughts.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">✦ ✦ ✦</div>

  <section>
    <p class="section-num">01</p>
    <h2 class="mb-8">Experience</h2>
    <ExperienceTimeline experiences={EXPERIENCES.slice(0, 1)} />
    <p class="mt-6">
      <a href={`${import.meta.env.BASE_URL}resume/`}>Full resume →</a>
    </p>
  </section>

  <section>
    <p class="section-num">02</p>
    <h2 class="mb-8">Selected projects</h2>
    <div class="flex flex-col gap-6">
      {projects.map((entry) => <ProjectEntryCard entry={entry} />)}
    </div>
    <p class="mt-6">
      <a href={`${import.meta.env.BASE_URL}projects/`}>All projects →</a>
    </p>
  </section>

  <section>
    <p class="section-num">03</p>
    <h2 class="mb-8">Latest thoughts</h2>
    {thoughts.length === 0 ? (
      <p class="text-stone-500">No thoughts yet.</p>
    ) : (
      thoughts.map((entry) => <NoteCard entry={entry} />)
    )}
    <p class="mt-6">
      <a href={`${import.meta.env.BASE_URL}thoughts/`}>All thoughts →</a>
    </p>
  </section>
</PageLayout>
