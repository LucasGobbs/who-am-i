---
import PageLayout from "../layouts/PageLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import ProjectEntryCard from "../components/ProjectEntryCard.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import {
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_LOCATION,
  EXPERIENCES,
  SITE_DESCRIPTION,
} from "../consts";
import { getSortedThoughts } from "../lib/thoughts";
import { getSortedProjects } from "../lib/projects";

const thoughts = (await getSortedThoughts()).slice(0, 3);
const projects = (await getSortedProjects()).slice(0, 2);
const first = SITE_AUTHOR.charAt(0);
const rest = SITE_AUTHOR.slice(1);
---

<PageLayout title={`${SITE_AUTHOR} — ${SITE_ROLE}`} description={SITE_DESCRIPTION}>
  <section class="hero" style="margin: 0 0 var(--gap-xxl);">
    <p class="kicker" style="margin: 0 0 1.2rem;">Notebook · Resume · Projects</p>
    <h1 class="mega-name" style="margin: 0; font-size: var(--step-mega); line-height: 0.9; letter-spacing: -0.04em;">
      <span style="color: var(--accent);">{first}</span><span>{rest}</span>
    </h1>
    <p style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-mute); margin: 1.2rem 0 0; letter-spacing: 0.04em;">
      {SITE_ROLE} · {SITE_LOCATION}
    </p>
    <p class="drop-cap" style="font-size: 1.15rem; line-height: 1.68; max-width: 58ch; color: var(--ink-soft); margin: var(--gap-xl) 0 0;">
      Software developer with 5+ years across backend, frontend, and DevOps.
      I build integrations and care about boring, observable, maintainable
      infrastructure. This site is my resume, my projects, and a small
      notebook of thoughts.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">✦ ✦ ✦</div>

  <section>
    <p class="section-num">01</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Experience</h2>
    <ExperienceTimeline experiences={EXPERIENCES.slice(0, 1)} />
    <p style="margin-top: var(--gap-md);">
      <a href={`${import.meta.env.BASE_URL}resume/`}>Full resume →</a>
    </p>
  </section>

  <section>
    <p class="section-num">02</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Selected projects</h2>
    <div style="display: flex; flex-direction: column; gap: var(--gap-md);">
      {projects.map((entry) => <ProjectEntryCard entry={entry} />)}
    </div>
    <p style="margin-top: var(--gap-md);">
      <a href={`${import.meta.env.BASE_URL}projects/`}>All projects →</a>
    </p>
  </section>

  <section>
    <p class="section-num">03</p>
    <h2 style="margin: 0 0 var(--gap-lg);">Latest thoughts</h2>
    {thoughts.length === 0 ? (
      <p style="color: var(--ink-mute);">No thoughts yet.</p>
    ) : (
      thoughts.map((entry) => <NoteCard entry={entry} />)
    )}
    <p style="margin-top: var(--gap-md);">
      <a href={`${import.meta.env.BASE_URL}thoughts/`}>All thoughts →</a>
    </p>
  </section>
</PageLayout>
