---
import PageLayout from "./PageLayout.astro";
import Tag from "../components/Tag.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const { entry, prev, next } = Astro.props;
const { title, date, tech, role, links, tags, description } = entry.data;

const dateFormatted = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);

const titleAttr = description ?? title;
---

<PageLayout title={title} description={titleAttr} canonical={`/projects/${entry.id}/`}>
  <div class="relative grid min-w-0 grid-cols-1 gap-10 xl:grid-cols-4 xl:gap-16 2xl:grid-cols-5 2xl:gap-20">
    <article class="note-article min-w-0 max-w-full xl:col-span-3 2xl:col-span-4">
      <header class="mb-10 min-w-0 break-words xl:mb-16">
        <p class="label mb-3 mt-0">
          <a href={`${import.meta.env.BASE_URL}projects/`} class="text-stone-500 no-underline">← Projects</a>
        </p>
        <h1 class="mb-2 mt-0 min-w-0 font-serif text-4xl break-words xl:text-5xl">{title}</h1>
        <p class="label m-0 text-stone-500">
          <time datetime={date.toISOString()}>{dateFormatted}</time>
          <span class="mx-2 text-stone-400">·</span>
          Role · {role}
        </p>
        {
          (tech.length > 0 || tags.length > 0) && (
            <ul class="mt-6 flex list-none flex-wrap gap-4 p-0">
              {tech.map((t) => (
                <li>
                  <Tag>{t}</Tag>
                </li>
              ))}
              {tags.map((t) => (
                <li>
                  <Tag>{t}</Tag>
                </li>
              ))}
            </ul>
          )
        }
        {
          links.length > 0 && (
            <p class="mt-6 font-mono text-xs tracking-wide">
              {links.map((link, i) => (
                <>
                  {i > 0 && <span class="mx-4 text-stone-200">/</span>}
                  <a href={link.href} class="text-stone-700 no-underline">
                    {link.label}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </header>

      <div class="prose-thoughts">
        <slot />
      </div>

      <nav class="mt-16 flex flex-wrap justify-between gap-6 border-t border-stone-200 pt-8 xl:gap-10" aria-label="Project navigation">
        <div class="min-w-0 flex-1">
          {prev ? (
            <a href={`${import.meta.env.BASE_URL}projects/${prev.slug}/`} rel="prev" class="min-w-0 break-words no-underline">
              <span class="label mb-1 block text-stone-400">Older</span>
              <span class="font-serif text-stone-700">← {prev.title}</span>
            </a>
          ) : (
            <span class="label text-stone-400">← Older</span>
          )}
        </div>
        <div class="min-w-0 flex-1 text-right">
          {next ? (
            <a href={`${import.meta.env.BASE_URL}projects/${next.slug}/`} rel="next" class="min-w-0 break-words no-underline">
              <span class="label mb-1 block text-stone-400">Newer</span>
              <span class="font-serif text-stone-700">{next.title} →</span>
            </a>
          ) : (
            <span class="label text-stone-400">Newer →</span>
          )}
        </div>
      </nav>
    </article>

    <button type="button" data-toc-toggle aria-label="Open sections" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="8" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="4" y1="12" x2="5.5" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="11" y1="18" x2="20" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="4" y1="18" x2="8.5" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <aside class="font-mono" aria-label="Sections" data-toc-aside>
      <div class="flex items-center justify-between">
        <p class="label m-0 text-stone-400">Sections</p>
        <button type="button" data-toc-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <ol data-section-toc class="mt-2 list-none p-0"></ol>
      <noscript>
        <p class="mt-2 font-mono text-xs text-stone-400">Section list visible with JavaScript.</p>
      </noscript>
    </aside>

    <div data-toc-overlay hidden></div>
  </div>
</PageLayout>

<script is:inline>
  (() => {
    const run = () => {
      const article = document.querySelector(".note-article");
      if (!article) return;
      const toc = document.querySelector("[data-section-toc]");
      const aside = document.querySelector("[data-toc-aside]");
      const toggle = document.querySelector("[data-toc-toggle]");
      const closeBtn = document.querySelector("[data-toc-close]");
      const overlay = document.querySelector("[data-toc-overlay]");
      const sections = [...article.querySelectorAll("[data-section-level]")];

      if (sections.length === 0) {
        if (aside) aside.hidden = true;
        if (toggle) toggle.hidden = true;
        return;
      }

      let h1 = 0;
      let h2 = 0;
      const items = [];
      sections.forEach((sec) => {
        const level = Number(sec.dataset.sectionLevel);
        if (level === 1) { h1 += 1; h2 = 0; }
        else { h2 += 1; }
        const num = level === 1 ? `${h1}` : `${h1}.${h2}`;
        const numSpan = sec.querySelector("[data-section-number]");
        if (numSpan) numSpan.textContent = `${num}  `;
        items.push({ num, title: sec.dataset.sectionTitle, id: sec.id, level });
      });

      if (toc) {
        toc.innerHTML = items.map((it) => `
          <li class="toc-item" data-level="${it.level}">
            <a href="#${it.id}" data-toc-link="${it.id}" class="toc-link">
              <span class="toc-number">${it.num}</span>${it.title}
            </a>
          </li>
        `).join("");
      }

      const links = new Map();
      document.querySelectorAll("[data-toc-link]").forEach((a) => {
        links.set(a.dataset.tocLink, a);
      });
      let activeLink = null;
      const setActive = (id) => {
        if (activeLink) activeLink.removeAttribute("data-state");
        const next = links.get(id);
        if (next) next.setAttribute("data-state", "active");
        activeLink = next || null;
      };
      const spy = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      }, { rootMargin: "-20% 0px -70% 0px", threshold: 0 });
      sections.forEach((sec) => spy.observe(sec));

      const open = () => {
        if (!aside || !toggle || !overlay) return;
        aside.setAttribute("data-open", "");
        overlay.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        if (!aside || !toggle || !overlay) return;
        aside.removeAttribute("data-open");
        overlay.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };
      if (toggle) toggle.addEventListener("click", open);
      if (closeBtn) closeBtn.addEventListener("click", close);
      if (overlay) overlay.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
      toc?.addEventListener("click", (e) => {
        if (e.target.closest("[data-toc-link]")) close();
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
