---
import BaseLayout from "./BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  jsonLd?: string;
  articleDate?: string;
  articleTags?: string[];
}

const { title, description, canonical, image, ogType, jsonLd, articleDate, articleTags } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  ogType={ogType}
  jsonLd={jsonLd}
  articleDate={articleDate}
  articleTags={articleTags}
>
  <Navigation />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
