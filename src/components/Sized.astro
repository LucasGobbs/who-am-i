---
// Sized text wrapper for editorial emphasis.
interface Props {
  as?: "h1" | "h2" | "h3" | "h4" | "p" | "span" | "div";
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  align?: "left" | "center" | "right";
  color?: "ink" | "soft" | "mute" | "faint" | "accent";
  serif?: boolean;
}
const {
  as: Tag = "p",
  size = "md",
  align = "left",
  color = "ink",
  serif = false,
} = Astro.props;

const sizes: Record<string, string> = {
  xs: "0.78rem",
  sm: "0.9rem",
  md: "1rem",
  lg: "1.4rem",
  xl: "1.9rem",
};
const colors: Record<string, string> = {
  ink: "var(--ink)",
  soft: "var(--ink-soft)",
  mute: "var(--ink-mute)",
  faint: "var(--ink-faint)",
  accent: "var(--accent)",
};
const family = serif ? "var(--font-display)" : "var(--font-body)";
---

<Tag
  class="my-[var(--gap-md)] block font-[family-name:var(--sized-font)] text-[length:var(--sized-size)] leading-[1.5] text-[var(--sized-color)] [text-align:var(--sized-align)]"
  style={`--sized-font: ${family}; --sized-size: ${sizes[size]}; --sized-color: ${colors[color]}; --sized-align: ${align};`}
>
  <slot />
</Tag>
