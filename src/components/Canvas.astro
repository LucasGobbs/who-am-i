---
// Inline animated canvas. Tiny script, scoped to canvas id.
interface Props {
  id: string;
  width?: number;
  height?: number;
  draw: string;
  caption?: string;
}
const {
  id,
  width = 600,
  height = 200,
  draw,
  caption,
} = Astro.props;
---

<figure class="my-[var(--gap-xl)] text-center">
  <canvas
    id={id}
    width={width}
    height={height}
    class="inline-block h-auto max-w-full rounded-[var(--radius-md)] border border-[var(--paper-edge)] bg-[var(--paper-deep)]"
  >
    Canvas not supported.
  </canvas>
  {
    caption && (
      <figcaption
        class="mt-2 font-[family-name:var(--font-mono)] text-[0.78rem] tracking-[0.03em] text-[var(--ink-mute)]"
      >
        {caption}
      </figcaption>
    )
  }
  <script is:inline define:vars={{ canvasId: id, w: width, h: height, drawSrc: draw }}>
    (() => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      const fn = new Function("return (" + drawSrc + ")")();
      let raf = 0;
      let start = performance.now();
      const loop = (now) => {
        const t = now - start;
        try { fn(ctx, t, w, h); } catch (e) { console.error(e); return; }
        raf = requestAnimationFrame(loop);
      };
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !reduce) {
            if (!raf) { start = performance.now(); raf = requestAnimationFrame(loop); }
          } else if (raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }
      }, { threshold: 0.01 });
      io.observe(canvas);
      if (reduce) {
        try { fn(ctx, 0, w, h); } catch (e) { console.error(e); }
      }
    })();
  </script>
</figure>
