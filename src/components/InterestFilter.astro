---
import { INTERESTS, type Interest } from "../consts";

interface Props {
  current: "all" | Interest;
  basePath: string;
}
const { current, basePath } = Astro.props;

const pills: { id: "all" | Interest; label: string }[] = [
  { id: "all", label: "All" },
  ...INTERESTS.map((i) => ({ id: i.id, label: i.label })),
];
---

<form
  data-interest-filter
  data-base-path={basePath}
  class="mb-[var(--gap-lg)] flex flex-wrap items-center gap-2 lg:mb-[var(--gap-xl)] lg:gap-[0.65rem] 2xl:gap-3"
>
  <span class="label mr-[0.3rem] text-[var(--ink-faint)] lg:mr-2 lg:text-[0.78rem]">Filter</span>
  {
    pills.map((p) => (
      <button
        type="button"
        data-interest={p.id}
        aria-pressed={p.id === current ? "true" : "false"}
        class="min-h-11 cursor-pointer rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] px-[0.7rem] py-1 font-[var(--font-mono)] text-[0.72rem] font-medium uppercase tracking-[0.05em] text-[var(--ink-mute)] transition-[background,color,border-color] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:border-[var(--ink-mute)] hover:text-[var(--ink)] aria-pressed:bg-[var(--ink)] aria-pressed:text-[var(--paper)] aria-pressed:border-[var(--ink)] aria-pressed:hover:text-[var(--paper)] lg:min-h-10 lg:px-[0.9rem] lg:py-[0.35rem] lg:text-[0.76rem] 2xl:px-4 2xl:py-[0.4rem] 2xl:text-[0.78rem]"
      >
        {p.label}
      </button>
    ))
  }
</form>

<script is:inline>
  (() => {
    const run = () => {
    const form = document.querySelector("[data-interest-filter]");
    if (!form) return;
    const list = document.querySelector("[data-interest-list]");
    if (!list) return;
    const params = new URLSearchParams(window.location.search);
    const current = params.get("i") || "all";

    const apply = (id) => {
      list.querySelectorAll("[data-interest-item]").forEach((el) => {
        const matches = id === "all" || el.dataset.interest === id;
        if (matches) { el.removeAttribute("hidden"); }
        else { el.setAttribute("hidden", ""); }
      });
      form.querySelectorAll("button[data-interest]").forEach((b) => {
        b.setAttribute("aria-pressed", b.dataset.interest === id ? "true" : "false");
      });
      const url = id === "all" ? form.dataset.basePath : `${form.dataset.basePath}?i=${id}`;
      window.history.replaceState({}, "", url);
    };

    form.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-interest]");
      if (!btn) return;
      apply(btn.dataset.interest);
    });

    apply(current);
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
