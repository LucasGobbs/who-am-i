---
import { INTERESTS, type Interest } from "../consts";

interface Props {
  current: "all" | Interest;
  basePath: string;
}
const { current, basePath } = Astro.props;

const pills: { id: "all" | Interest; label: string }[] = [
  { id: "all", label: "All" },
  ...INTERESTS.map((i) => ({ id: i.id, label: i.label })),
];
---

<form
  data-interest-filter
  data-base-path={basePath}
  class="mb-8 flex flex-wrap items-center gap-2 lg:mb-12 lg:gap-2 xl:gap-3"
>
  <span class="label mr-1 text-stone-400 lg:mr-2 lg:text-xs">Filter</span>
  {
    pills.map((p) => (
      <button
        type="button"
        data-interest={p.id}
        aria-pressed={p.id === current ? "true" : "false"}
        class="min-h-11 cursor-pointer rounded-full border border-stone-300 bg-stone-100 px-3 py-1 font-mono text-xs font-medium uppercase tracking-wider text-stone-600 transition-colors duration-150 ease-out hover:border-stone-500 hover:text-stone-950 aria-pressed:border-stone-950 aria-pressed:bg-stone-950 aria-pressed:text-stone-50 aria-pressed:hover:text-stone-50 lg:min-h-10 lg:px-4 lg:py-1 xl:text-sm"
      >
        {p.label}
      </button>
    ))
  }
</form>

<script is:inline>
  (() => {
    const run = () => {
    const form = document.querySelector("[data-interest-filter]");
    if (!form) return;
    const list = document.querySelector("[data-interest-list]");
    if (!list) return;
    const params = new URLSearchParams(window.location.search);
    const current = params.get("i") || "all";

    const apply = (id) => {
      list.querySelectorAll("[data-interest-item]").forEach((el) => {
        const matches = id === "all" || el.dataset.interest === id;
        if (matches) { el.removeAttribute("hidden"); }
        else { el.setAttribute("hidden", ""); }
      });
      form.querySelectorAll("button[data-interest]").forEach((b) => {
        b.setAttribute("aria-pressed", b.dataset.interest === id ? "true" : "false");
      });
      const url = id === "all" ? form.dataset.basePath : `${form.dataset.basePath}?i=${id}`;
      window.history.replaceState({}, "", url);
    };

    form.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-interest]");
      if (!btn) return;
      apply(btn.dataset.interest);
    });

    apply(current);
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
