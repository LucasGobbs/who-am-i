---
// Captioned figure.
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolved = src.startsWith("/") ? `${base}${src.replace(/^\//, "")}` : src;
---

<figure class="my-12 text-center">
  <img
    src={resolved}
    alt={alt}
    loading="lazy"
    decoding="async"
    class="inline-block h-auto max-w-full rounded-md border border-stone-300"
  />
  {
    caption && (
      <figcaption
        class="mt-2 font-mono text-xs tracking-wide text-stone-500"
      >
        {caption}
      </figcaption>
    )
  }
</figure>
