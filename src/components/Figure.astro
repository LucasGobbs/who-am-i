---
// Captioned figure.
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolved = src.startsWith("/") ? `${base}${src.replace(/^\//, "")}` : src;
---

<figure style="margin: var(--gap-xl) 0; text-align: center;">
  <img
    src={resolved}
    alt={alt}
    loading="lazy"
    decoding="async"
    style="max-width: 100%; height: auto; border-radius: var(--radius-md); border: 1px solid var(--paper-edge); display: inline-block;"
  />
  {
    caption && (
      <figcaption
        style="margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-mute); letter-spacing: 0.03em;"
      >
        {caption}
      </figcaption>
    )
  }
</figure>
