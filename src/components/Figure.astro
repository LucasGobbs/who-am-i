---
// Captioned figure.
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolved = src.startsWith("/") ? `${base}${src.replace(/^\//, "")}` : src;
---

<figure class="my-[var(--gap-xl)] text-center">
  <img
    src={resolved}
    alt={alt}
    loading="lazy"
    decoding="async"
    class="inline-block h-auto max-w-full rounded-[var(--radius-md)] border border-[var(--paper-edge)]"
  />
  {
    caption && (
      <figcaption
        class="mt-2 font-[family-name:var(--font-mono)] text-[0.78rem] tracking-[0.03em] text-[var(--ink-mute)]"
      >
        {caption}
      </figcaption>
    )
  }
</figure>
