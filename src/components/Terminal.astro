---
// Faux terminal window, static HTML + tiny progressive-enhancement script
// for per-line copy buttons. The one dark surface on the page.
interface Props {
  title?: string;
}
const { title = "terminal" } = Astro.props;
---

<figure
  class="terminal my-12 min-w-0 max-w-full overflow-hidden rounded-lg border border-stone-900 bg-stone-950 shadow-lg"
  data-terminal
>
  <figcaption
    class="flex items-center gap-2 border-b border-stone-900 bg-stone-950 px-3 py-2 font-mono text-xs tracking-wide text-stone-400"
  >
    <span class="inline-flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-red-500"></span>
      <span class="size-2.5 rounded-full bg-amber-500"></span>
      <span class="size-2.5 rounded-full bg-green-500"></span>
    </span>
    <span class="ml-2 opacity-90">{title}</span>
  </figcaption>
  <pre
    class="m-0 min-w-0 max-w-full overflow-x-auto px-8 py-6 font-mono text-sm leading-relaxed text-stone-100 sm:px-6"
  ><slot /></pre>
</figure>


<script is:inline>
  (() => {
    const blocks = document.querySelectorAll(".terminal[data-terminal]");
    if (!blocks.length) return;
    const ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
    blocks.forEach((block) => {
      const lines = block.querySelectorAll(".term-line");
      lines.forEach((line) => {
        const content = line.querySelector(".term-content");
        if (!content) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "term-copy";
        btn.setAttribute("aria-label", "Copy line to clipboard");
        btn.innerHTML = ICON;
        btn.addEventListener("click", async () => {
          const text = content.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            btn.innerHTML = CHECK;
            btn.dataset.copied = "true";
            setTimeout(() => {
              btn.innerHTML = ICON;
              delete btn.dataset.copied;
            }, 1200);
          } catch (e) {
            console.error("Clipboard write failed", e);
          }
        });
        line.appendChild(btn);
      });
    });
  })();
</script>
