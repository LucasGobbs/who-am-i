---
// Faux terminal window, static HTML + tiny progressive-enhancement script
// for per-line copy buttons. The one dark surface on the page.
interface Props {
  title?: string;
}
const { title = "terminal" } = Astro.props;
---

<figure
  class="terminal my-[var(--gap-xl)] min-w-0 max-w-full overflow-hidden rounded-[var(--radius-lg)] border border-[#1c1917] bg-[#050505] shadow-[0_8px_24px_rgba(28,23,20,0.12)]"
  data-terminal
>
  <figcaption
    class="flex items-center gap-2 border-b border-[#1c1917] bg-[#0a0a0a] px-[0.8rem] py-2 font-[var(--font-mono)] text-[0.72rem] tracking-[0.04em] text-[var(--terminal-mute)]"
  >
    <span class="inline-flex gap-[0.35rem]" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-[#ef4444]"></span>
      <span class="size-2.5 rounded-full bg-[#f59e0b]"></span>
      <span class="size-2.5 rounded-full bg-[#22c55e]"></span>
    </span>
    <span class="ml-2 opacity-90">{title}</span>
  </figcaption>
  <pre
    class="m-0 min-w-0 max-w-full overflow-x-auto px-[var(--gap-lg)] py-[var(--gap-md)] font-[var(--font-mono)] text-[0.85rem] leading-[1.6] text-[var(--terminal-ink)] max-[480px]:px-[var(--gap-md)]"
  ><slot /></pre>
</figure>


<script is:inline>
  (() => {
    const blocks = document.querySelectorAll(".terminal[data-terminal]");
    if (!blocks.length) return;
    const ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
    blocks.forEach((block) => {
      const lines = block.querySelectorAll(".term-line");
      lines.forEach((line) => {
        const content = line.querySelector(".term-content");
        if (!content) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "term-copy";
        btn.setAttribute("aria-label", "Copy line to clipboard");
        btn.innerHTML = ICON;
        btn.addEventListener("click", async () => {
          const text = content.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            btn.innerHTML = CHECK;
            btn.dataset.copied = "true";
            setTimeout(() => {
              btn.innerHTML = ICON;
              delete btn.dataset.copied;
            }, 1200);
          } catch (e) {
            console.error("Clipboard write failed", e);
          }
        });
        line.appendChild(btn);
      });
    });
  })();
</script>
