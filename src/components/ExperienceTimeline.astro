---
import type { Experience } from "../consts";
import { formatExperienceRange } from "../consts";

interface Props {
  experiences: Experience[];
}
const { experiences } = Astro.props;

const years = [
  ...new Set(experiences.map((e) => e.startYear)),
].sort((a, b) => a - b);
---

<p class="kicker m-0 mb-[var(--gap-lg)]">
  {years.join("  ·  ")}
</p>

<ol class="relative m-0 list-none p-0 before:absolute before:top-0 before:bottom-0 before:left-[0.75rem] before:w-px before:bg-[var(--paper-edge)]">
  {
    experiences.map((e, i) => (
      <li class="relative pb-[var(--gap-xxl)] pl-[2.5rem] last:pb-0">
        <span
          class="absolute top-[0.35rem] left-0 flex size-[1.5rem] items-center justify-center rounded-full border-2 border-[var(--accent)] bg-[var(--paper)] font-[var(--font-mono)] text-[0.6rem] font-semibold text-[var(--accent)]"
          aria-hidden="true"
        >{String(i + 1).padStart(2, "0")}</span>
        <p class="label m-0 mb-[0.4rem] font-semibold text-[var(--accent)]">
          {formatExperienceRange(e)}
        </p>
        <h3 class="m-0 mb-[0.5rem] text-[1.35rem] leading-[1.15]">
          {e.role}
        </h3>
        <p class="m-0 mb-[var(--gap-sm)] font-[var(--font-mono)] text-[0.82rem] tracking-[0.04em] text-[var(--ink-mute)] uppercase">
          {e.company}
        </p>
        <p class="m-0 mb-[var(--gap-md)] text-[1rem] leading-[1.6] text-[var(--ink-soft)]">
          {e.summary}
        </p>
        <ul class="my-[var(--gap-sm)] pl-[1.25rem] text-[0.94rem] leading-[1.55] text-[var(--ink-soft)]">
          {e.highlights.map((h) => (
            <li class="my-[0.4rem]">{h}</li>
          ))}
        </ul>
        {e.tech.length > 0 && (
          <ul class="m-0 mt-[var(--gap-md)] flex list-none flex-wrap gap-[0.4rem] p-0">
            {e.tech.map((t) => (
              <li class="rounded-[var(--radius-pill)] border border-[var(--paper-edge)] bg-[var(--paper-deep)] px-[0.6rem] py-[0.18rem] font-[var(--font-mono)] text-[0.72rem] font-medium tracking-[0.04em] text-[var(--ink-soft)]">
                {t}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
