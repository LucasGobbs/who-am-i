---
import type { Experience } from "../consts";
import { formatExperienceRange } from "../consts";

interface Props {
  experiences: Experience[];
}
const { experiences } = Astro.props;

const years = [
  ...new Set(experiences.map((e) => e.startYear)),
].sort((a, b) => a - b);
---

<p class="kicker m-0 mb-8">
  {years.join("  ·  ")}
</p>

<ol class="relative m-0 list-none p-0 before:absolute before:top-0 before:bottom-0 before:left-3 before:w-px before:bg-stone-300">
  {
    experiences.map((e, i) => (
      <li class="relative pb-16 pl-10 last:pb-0">
        <span
          class="absolute top-1.5 left-0 flex size-6 items-center justify-center rounded-full border-2 border-orange-600 bg-stone-50 font-mono text-xs font-semibold text-orange-600"
          aria-hidden="true"
        >{String(i + 1).padStart(2, "0")}</span>
        <p class="label m-0 mb-2 font-semibold text-orange-600">
          {formatExperienceRange(e)}
        </p>
        <h3 class="m-0 mb-2 text-xl leading-tight">
          {e.role}
        </h3>
        <p class="m-0 mb-4 font-mono text-sm tracking-wide text-stone-500 uppercase">
          {e.company}
        </p>
        <p class="m-0 mb-6 text-base leading-relaxed text-stone-700">
          {e.summary}
        </p>
        <ul class="my-4 pl-5 text-sm leading-relaxed text-stone-700">
          {e.highlights.map((h) => (
            <li class="my-2">{h}</li>
          ))}
        </ul>
        {e.tech.length > 0 && (
          <ul class="m-0 mt-6 flex list-none flex-wrap gap-2 p-0">
            {e.tech.map((t) => (
              <li class="rounded-full border border-stone-300 bg-stone-100 px-2 py-0.5 font-mono text-xs font-medium tracking-wide text-stone-700">
                {t}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
