---
// Callout / aside box. note / warn / tip.
interface Props {
  kind?: "note" | "warn" | "tip";
  title?: string;
}
const { kind = "note", title } = Astro.props;

const palette: Record<string, { bg: string; fg: string; label: string }> = {
  note: { bg: "#fbf3d0", fg: "#4a3a12", label: "Note" },
  warn: { bg: "#f5d8c8", fg: "#5a1d0c", label: "Warning" },
  tip: { bg: "#e8eee5", fg: "#28402a", label: "Tip" },
};
const p = palette[kind];
---

<aside
  class="my-[var(--gap-lg)] min-w-0 max-w-full break-words rounded-[var(--radius-sm)] px-[var(--gap-md)] py-[var(--gap-md)] text-[var(--callout-fg)] [background:var(--callout-bg)] sm:px-[var(--gap-lg)] [&_ol]:max-w-full [&_p]:max-w-full [&_pre]:max-w-full [&_table]:max-w-full [&_ul]:max-w-full"
  style={`--callout-bg: ${p.bg}; --callout-fg: ${p.fg};`}
>
  <p class="label m-0 mb-[0.4rem] text-[var(--callout-fg)] opacity-70">
    {title ?? p.label}
  </p>
  <div class="m-0 text-[0.96rem] leading-[1.6]">
    <slot />
  </div>
</aside>
