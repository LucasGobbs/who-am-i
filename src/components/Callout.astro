---
// Callout / aside box. note / warn / tip.
interface Props {
  kind?: "note" | "warn" | "tip";
  title?: string;
}
const { kind = "note", title } = Astro.props;

const palette: Record<string, { bg: string; fg: string; label: string; icon: string }> = {
  note: { bg: "#e8eee5", fg: "#28402a", label: "Note", icon: "document" },
  warn: { bg: "#f5d8c8", fg: "#5a1d0c", label: "Warning", icon: "stop" },
  tip: { bg: "#fbf3d0", fg: "#4a3a12", label: "Tip", icon: "lightbulb" },
};
const p = palette[kind];

const icons: Record<string, string> = {
  document: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="inline-block h-4 w-4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" style="fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"/></svg>',
  stop: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="inline-block h-4 w-4"><polygon points="7 2 17 2 22 7 22 17 17 22 7 22 2 17 2 7"/></svg>',
  lightbulb: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block h-4 w-4"><path d="M9 21h6"/><path d="M12 3a7 7 0 0 0-4 12.74V18h8v-2.26A7 7 0 0 0 12 3Z"/><path d="M9 18h6"/></svg>',
};
---

<aside
  class="my-8 min-w-0 max-w-full break-words rounded-sm px-6 py-6 text-[var(--callout-fg)] [background:var(--callout-bg)] sm:px-8 [&_ol]:max-w-full [&_p]:max-w-full [&_pre]:max-w-full [&_table]:max-w-full [&_ul]:max-w-full"
  style={`--callout-bg: ${p.bg}; --callout-fg: ${p.fg};`}
>
  <p class="label m-0 mb-2 flex items-center gap-2 text-[var(--callout-fg)] opacity-70">
    <span class="inline-flex flex-shrink-0" set:html={icons[p.icon]} />
    {title ?? p.label}
  </p>
  <div class="m-0 text-base leading-relaxed">
    <slot />
  </div>
</aside>
