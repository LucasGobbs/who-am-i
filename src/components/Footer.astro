---
import { SOCIAL_LINKS, SITE_AUTHOR } from "../consts";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer
  class="mt-auto border-t border-[var(--paper-edge)] bg-[var(--paper)]"
>
  <div
    class="mx-auto flex w-full max-w-[var(--shell-max)] flex-wrap items-baseline justify-between gap-4 px-[var(--page-padding)] py-6"
  >
    <p
      class="m-0 font-[var(--font-mono)] text-[0.75rem] tracking-[0.04em] text-[var(--ink-mute)]"
    >
      &copy; {year} {SITE_AUTHOR}
    </p>
    <ul
      class="m-0 flex list-none flex-wrap gap-[1.1rem] p-0"
    >
      {
        SOCIAL_LINKS.map((link) => {
          const href = link.href.startsWith("http") || link.href.startsWith("mailto")
            ? link.href
            : `${base}${link.href}`;
          return (
            <li>
              <a
                href={href}
                class="font-[var(--font-mono)] text-[0.75rem] font-medium uppercase tracking-[0.06em] text-[var(--ink-soft)] no-underline transition-colors duration-[var(--dur-fast)] ease-[var(--ease-out)]"
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
