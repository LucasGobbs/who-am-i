---
import { SOCIAL_LINKS, SITE_AUTHOR } from "../consts";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer
  class="mt-auto border-t border-stone-300 bg-stone-50"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-wrap items-baseline justify-between gap-4 px-4 py-6 sm:px-6 lg:px-8"
  >
    <p
      class="m-0 font-mono text-xs tracking-wide text-stone-500"
    >
      &copy; {year} {SITE_AUTHOR}
    </p>
    <ul
      class="m-0 flex list-none flex-wrap gap-4 p-0"
    >
      {
        SOCIAL_LINKS.map((link) => {
          const href = link.href.startsWith("http") || link.href.startsWith("mailto")
            ? link.href
            : `${base}${link.href}`;
          return (
            <li>
              <a
                href={href}
                class="font-mono text-xs font-medium uppercase tracking-wider text-stone-700 no-underline transition-colors duration-150 ease-out"
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
