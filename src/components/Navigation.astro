---
import { NAV_LINKS, SITE_AUTHOR, SITE_ROLE } from "../consts";

const base = import.meta.env.BASE_URL;
const withBase = (href: string) =>
  href === "/" ? base : `${base}${href.replace(/^\//, "")}`;
const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === base) return path === base || path === base.replace(/\/$/, "");
  return path.startsWith(href);
};
---

<header
  class="sticky top-0 z-10 border-b border-[var(--ink)] bg-[var(--paper)] [backdrop-filter:saturate(1.1)]"
>
  <div
    class="mx-auto flex w-full max-w-[var(--shell-max)] flex-wrap items-baseline justify-between gap-4 px-[var(--page-padding)] py-[0.9rem]"
  >
    <a
      href={base}
      class="font-[var(--font-display)] text-[1.3rem] font-normal tracking-[-0.02em] text-[var(--ink)] no-underline"
    >
      <span class="text-[var(--accent)]">L</span><span>ucas&nbsp;Gobbi</span>
      <span
        class="ml-[0.7rem] align-[0.1em] font-[var(--font-mono)] text-[0.68rem] font-medium uppercase tracking-[0.1em] text-[var(--ink-mute)]"
      >
        {SITE_ROLE}
      </span>
    </a>
    <nav aria-label="Primary">
      <ul
        class="m-0 flex list-none flex-wrap gap-[1.3rem] p-0"
      >
        {
          NAV_LINKS.map((link) => {
            const href = withBase(link.href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? "page" : undefined}
                  class="font-[var(--font-mono)] text-[0.76rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink-soft)] no-underline transition-colors duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:text-[var(--ink)] aria-[current=page]:text-[var(--accent)]"
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
