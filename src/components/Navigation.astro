---
import { NAV_LINKS, SITE_AUTHOR, SITE_ROLE } from "../consts";

const base = import.meta.env.BASE_URL;
const withBase = (href: string) =>
  href === "/" ? base : `${base}${href.replace(/^\//, "")}`;
const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === base) return path === base || path === base.replace(/\/$/, "");
  return path.startsWith(href);
};
---

<header
  class="sticky top-0 z-10 border-b border-stone-950 bg-stone-50 backdrop-saturate-100"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-wrap items-baseline justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
  >
    <a
      href={base}
      class="font-serif text-xl font-normal tracking-tight text-stone-950 no-underline"
    >
      <span class="text-orange-600">L</span><span>ucas&nbsp;Gobbi</span>
      <span
        class="ml-3 align-baseline font-mono text-xs font-medium uppercase tracking-widest text-stone-500"
      >
        {SITE_ROLE}
      </span>
    </a>
    <nav aria-label="Primary">
      <ul
        class="m-0 flex list-none flex-wrap gap-5 p-0"
      >
        {
          NAV_LINKS.map((link) => {
            const href = withBase(link.href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? "page" : undefined}
                  class:list={[
                    "font-mono text-xs font-semibold uppercase tracking-wider no-underline transition-colors duration-150 ease-out hover:text-stone-950",
                    isActive(href) ? "text-stone-950" : "text-stone-700",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
