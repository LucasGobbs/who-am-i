---
import Tag from "./Tag.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, description, tech, tags, thumbnail, thumbnailAlt, date } = entry.data;
const hasThumb = Boolean(thumbnail);
---

<article
  class="group overflow-hidden rounded-md border border-stone-300 bg-stone-100 transition-colors duration-150 ease-out hover:border-stone-500"
>
  <a
    href={`${import.meta.env.BASE_URL}projects/${entry.id}/`}
    class:list={[
      "flex text-inherit no-underline",
      {
        "min-h-36 items-stretch flex-col lg:min-h-44 lg:flex-row xl:min-h-48": hasThumb,
      },
    ]}
    aria-label={title}
  >
    <div
      class:list={[
        "min-w-0",
        {
          "flex flex-1 flex-col justify-center px-8 py-6 lg:py-12 lg:pr-12 xl:p-12": hasThumb,
          "px-8 py-6": !hasThumb,
        },
      ]}
    >
      <h3 class="m-0 mb-1 text-lg leading-snug text-stone-950 lg:text-xl">{title}</h3>
      {description && <p class="m-0 mb-4 text-sm leading-relaxed text-stone-700 lg:text-base">{description}</p>}
      {(tech.length > 0 || tags.length > 0) && (
        <ul class="m-0 mb-4 flex list-none flex-wrap gap-2 p-0">
          {tech.map((t) => <li><Tag>{t}</Tag></li>)}
          {tags.map((t) => <li><Tag>{t}</Tag></li>)}
        </ul>
      )}
      <p class="m-0 font-mono text-xs tracking-wide text-stone-400">
        <time datetime={date.toISOString()}>
          {new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short" }).format(date)}
        </time>
      </p>
    </div>
    {hasThumb && (
      <div class="flex min-h-0 w-full flex-none items-stretch overflow-hidden border-t border-stone-300 bg-stone-50 lg:min-h-full lg:w-72 lg:border-t-0 lg:border-l xl:w-80">
        <img
          src={thumbnail!.startsWith("/") ? `${import.meta.env.BASE_URL}${thumbnail!.replace(/^\//, "")}` : thumbnail}
          alt={thumbnailAlt ?? title}
          loading="lazy"
          decoding="async"
          class="block h-auto w-full rounded-none object-cover transition-transform duration-300 ease-out group-hover:scale-105 lg:h-full lg:aspect-auto aspect-video"
        />
      </div>
    )}
  </a>
</article>
