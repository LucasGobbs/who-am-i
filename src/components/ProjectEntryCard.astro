---
import Tag from "./Tag.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, description, tech, tags, thumbnail, thumbnailAlt, date } = entry.data;
const hasThumb = Boolean(thumbnail);
---

<article class:list={["project-entry-card", { "has-thumb": hasThumb }]}>
  <a href={`${import.meta.env.BASE_URL}projects/${entry.id}/`} class="card-link" aria-label={title}>
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      {description && <p class="card-desc">{description}</p>}
      {(tech.length > 0 || tags.length > 0) && (
        <ul class="card-tags">
          {tech.map((t) => <li><Tag>{t}</Tag></li>)}
          {tags.map((t) => <li><Tag>{t}</Tag></li>)}
        </ul>
      )}
      <p class="card-date">
        <time datetime={date.toISOString()}>
          {new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short" }).format(date)}
        </time>
      </p>
    </div>
    {hasThumb && (
      <div class="card-thumb">
        <img
          src={thumbnail!.startsWith("/") ? `${import.meta.env.BASE_URL}${thumbnail!.replace(/^\//, "")}` : thumbnail}
          alt={thumbnailAlt ?? title}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </a>
</article>

<style>
  .project-entry-card {
    border: 1px solid var(--paper-edge);
    border-radius: var(--radius-md);
    background: var(--paper-deep);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .project-entry-card:hover {
    border-color: var(--ink-mute);
  }

  .card-link {
    display: flex;
    text-decoration: none;
    color: inherit;
  }

  /* No thumb: simple row */
  .project-entry-card:not(.has-thumb) .card-body {
    padding: var(--gap-md) var(--gap-lg);
  }

  /* With thumb: body left, image right */
  .has-thumb .card-link {
    flex-direction: row;
    align-items: stretch;
    min-height: 140px;
  }

  .has-thumb .card-body {
    flex: 1 1 0%;
    min-width: 0;
    padding: var(--gap-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-thumb {
    flex: 0 0 auto;
    width: 200px;
    min-height: 100%;
    overflow: hidden;
    border-left: 1px solid var(--paper-edge);
    background: var(--paper);
    display: flex;
    align-items: stretch;
  }

  .card-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-med) var(--ease-out);
  }

  .has-thumb:hover .card-thumb img {
    transform: scale(1.03);
  }


  /* Shared body */
  .card-title {
    margin: 0 0 0.25rem;
    font-size: var(--step-title, 1.1rem);
    color: var(--ink);
    line-height: 1.3;
  }

  .card-desc {
    margin: 0 0 var(--gap-sm);
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .card-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--gap-sm);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .card-date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  /* Large screens: bigger thumbnails, taller cards */
  @media (min-width: 1024px) {
    .has-thumb .card-link {
      min-height: 180px;
    }

    .card-thumb {
      width: 280px;
    }

    .has-thumb .card-body {
      padding: var(--gap-xl) var(--gap-xl) var(--gap-xl) var(--gap-lg);
    }

    .card-title {
      font-size: 1.25rem;
    }

    .card-desc {
      font-size: 1rem;
      line-height: 1.62;
    }
  }

  /* Extra large screens: even more generous */
  @media (min-width: 1440px) {
    .has-thumb .card-link {
      min-height: 200px;
    }

    .card-thumb {
      width: 320px;
    }

    .has-thumb .card-body {
      padding: var(--gap-xl);
    }
  }

  /* Mobile: stack vertically */
  @media (max-width: 640px) {
    .has-thumb .card-link {
      flex-direction: column;
      min-height: 0;
    }

    .card-thumb {
      width: 100%;
      min-height: 0;
      border-left: 0;
      border-top: 1px solid var(--paper-edge);
    }

    .card-thumb img {
      aspect-ratio: 16 / 9;
      height: auto;
    }

    .has-thumb .card-body {
      padding: var(--gap-md) var(--gap-lg);
    }
  }
</style>
