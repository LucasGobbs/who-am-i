---
// Inline academic-style citation. Links to a Reference entry at the bottom.
// Usage: <Cite id="knuth1984" /> → renders [?] linking to #ref-knuth1984
// Number is filled client-side from the <References> list order.
// Optional n prop overrides auto-numbering if you want manual control.
interface Props {
  id: string;
  n?: number;
}
const { id, n } = Astro.props;
---

<a
  href={`#ref-${id}`}
  class="cite ml-[0.1em] align-super font-[family-name:var(--font-mono)] text-[0.78em] leading-none text-[var(--accent)] no-underline transition-colors [transition-duration:var(--dur-fast)] [transition-timing-function:var(--ease-out)]"
  data-cite={id}
  data-cite-n={n ?? undefined}
>[{n ?? "?"}]</a>