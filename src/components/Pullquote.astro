---
// Large display quote. Editorial pull-quote.
---

<blockquote
  class="my-[var(--gap-xl)] border-0 bg-transparent p-0 text-center font-[family-name:var(--font-display)] text-[1.45rem] italic leading-[1.4] text-[var(--ink)]"
>
  <span class="mb-[0.3rem] block text-[2rem] not-italic leading-none text-[var(--ink-mute)]">&ldquo;</span>
  <slot />
</blockquote>
