---
// Large display quote. Editorial pull-quote.
---

<blockquote
  data-pullquote
  class="my-12 border-0 bg-transparent p-0 text-center font-serif text-2xl italic leading-snug text-stone-950"
>
  <span class="mb-4 block text-3xl not-italic leading-none text-stone-500">&ldquo;</span>
  <slot />
  <span class="inline text-3xl not-italic leading-none text-stone-500">&rdquo;</span>
</blockquote>
