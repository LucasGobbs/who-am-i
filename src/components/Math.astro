---
// Math equation widget. Renders inline or block via KaTeX-like manual layout.
// No external deps — just styled HTML. For real LaTeX, use KaTeX remark plugin later.
// Usage:
//   <Math>E = mc^2</Math>                     → inline
//   <Math block>E = mc^2</Math>               → block, centered
//   <Math block label="eq:energy">E = mc^2</Math>  → numbered, referenceable
// For superscript/subscript, use <sup>/<sub> tags inside:
//   <Math block>E = m<sup>2</sup>c<sup>4</sup></Math>
interface Props {
  block?: boolean;
  label?: string;
}
const { block = false, label } = Astro.props;
---

{
  block ? (
    <figure
      class="my-[var(--gap-lg)] w-full min-w-0 max-w-[var(--readable-max)] overflow-x-auto text-center"
      id={label ? `eq-${label}` : undefined}
    >
      <div
        class="inline-block min-w-max p-[clamp(0.25rem,1.5vw,var(--gap-sm))_clamp(0.5rem,3vw,var(--gap-md))] font-[var(--font-display)] text-[clamp(1rem,2.5vw,1.2rem)] italic leading-[1.8] text-[var(--ink)] [&_sub]:align-sub [&_sub]:text-[0.7em] [&_sub]:not-italic [&_sup]:align-super [&_sup]:text-[0.7em] [&_sup]:not-italic"
      >
        <slot />
      </div>
      {label && (
        <span
          class="ml-4 align-middle font-[var(--font-mono)] text-[0.75rem] text-[var(--ink-faint)]"
        >
          ({label.replace(/^eq:/, "")})
        </span>
      )}
    </figure>
  ) : (
    <span
      class="break-words px-[0.15em] font-[var(--font-display)] text-[1.05em] italic text-[var(--ink)] [&_sub]:align-sub [&_sub]:text-[0.7em] [&_sub]:not-italic [&_sup]:align-super [&_sup]:text-[0.7em] [&_sup]:not-italic"
    >
      <slot />
    </span>
  )
}
