---
// Math equation widget. Renders inline or block via KaTeX-like manual layout.
// No external deps — just styled HTML. For real LaTeX, use KaTeX remark plugin later.
// Usage:
//   <Math>E = mc^2</Math>                     → inline
//   <Math block>E = mc^2</Math>               → block, centered
//   <Math block label="eq:energy">E = mc^2</Math>  → numbered, referenceable
// For superscript/subscript, use <sup>/<sub> tags inside:
//   <Math block>E = m<sup>2</sup>c<sup>4</sup></Math>
interface Props {
  block?: boolean;
  label?: string;
}
const { block = false, label } = Astro.props;
---

{
  block ? (
    <figure
      class="my-8 w-full min-w-0 max-w-3xl overflow-x-auto text-center"
      id={label ? `eq-${label}` : undefined}
    >
      <div
        class="inline-block min-w-max p-2 font-serif text-base italic leading-loose text-stone-950 sm:p-3 sm:text-lg [&_sub]:align-sub [&_sub]:text-xs [&_sub]:not-italic [&_sup]:align-super [&_sup]:text-xs [&_sup]:not-italic"
      >
        <slot />
      </div>
      {label && (
        <span
          class="ml-4 align-middle font-mono text-xs text-stone-400"
        >
          ({label.replace(/^eq:/, "")})
        </span>
      )}
    </figure>
  ) : (
    <span
      class="break-words px-px font-serif text-base italic text-stone-950 [&_sub]:align-sub [&_sub]:text-xs [&_sub]:not-italic [&_sup]:align-super [&_sup]:text-xs [&_sup]:not-italic"
    >
      <slot />
    </span>
  )
}
