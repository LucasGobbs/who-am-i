---
import Tag from "./Tag.astro";
import type { Project } from "../consts";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const hasThumb = Boolean(project.thumbnail);
---

<article
  class:list={[
    "my-6 overflow-hidden rounded-md border border-stone-300 bg-stone-100",
    { "grid grid-cols-1 items-stretch gap-0 sm:grid-cols-12": hasThumb },
  ]}
>
  <div class:list={["p-8", { "col-span-7 sm:col-span-1 lg:col-span-7": hasThumb }]}>
    <div>
      <h3 class="m-0 mb-2 text-xl text-stone-950">
        {project.name}
      </h3>
      <p class="label m-0 mb-4 text-stone-500">
        Role · {project.role}
      </p>
    </div>
    <p class="m-0 mb-4 text-base leading-relaxed text-stone-700">
      {project.description}
    </p>
    {
      project.tech.length > 0 && (
        <ul class="m-0 mb-4 flex list-none flex-wrap gap-2 p-0">
          {project.tech.map((t) => (
            <li>
              <Tag>{t}</Tag>
            </li>
          ))}
        </ul>
      )
    }
    {
      project.links.length > 0 && (
        <p class="m-0 mt-4 font-mono text-xs tracking-wide">
          {project.links.map((link, i) => (
            <>
              {i > 0 && <span class="mx-2 text-stone-300">/</span>}
              <a href={link.href} class="text-stone-700 no-underline">
                {link.label}
              </a>
            </>
          ))}
        </p>
      )
    }
  </div>
  {
    hasThumb && (
      <div class="col-span-5 flex items-stretch border-t-0 border-l border-stone-300 bg-stone-50 sm:col-span-1 sm:border-t sm:border-l-0 lg:col-span-5 lg:border-t-0 lg:border-l">
        <img
          src={project.thumbnail!.startsWith("/") ? `${import.meta.env.BASE_URL}${project.thumbnail!.replace(/^\//, "")}` : project.thumbnail}
          alt={project.thumbnailAlt ?? project.name}
          loading="lazy"
          decoding="async"
          class="block h-full max-h-none w-full rounded-none object-cover sm:h-auto sm:max-h-60 lg:h-full lg:max-h-none"
        />
      </div>
    )
  }
</article>
