---
import Tag from "./Tag.astro";
import type { Project } from "../consts";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const hasThumb = Boolean(project.thumbnail);
---

<article
  class:list={["project-card", { "has-thumb": hasThumb }]}
  style="border: 1px solid var(--paper-edge); border-radius: var(--radius-md); background: var(--paper-deep); margin: var(--gap-md) 0; overflow: hidden;"
>
  <div class="project-body" style="padding: var(--gap-lg);">
    <div class="project-head">
      <h3 style="margin: 0 0 0.4rem; font-size: var(--step-title); color: var(--ink);">
        {project.name}
      </h3>
      <p class="label" style="margin: 0 0 var(--gap-sm); color: var(--ink-mute);">
        Role · {project.role}
      </p>
    </div>
    <p style="margin: 0 0 var(--gap-sm); color: var(--ink-soft); font-size: 0.98rem; line-height: 1.55;">
      {project.description}
    </p>
    {
      project.tech.length > 0 && (
        <ul
          style="list-style: none; padding: 0; margin: 0 0 var(--gap-sm); display: flex; gap: 0.4rem; flex-wrap: wrap;"
        >
          {project.tech.map((t) => (
            <li>
              <Tag>{t}</Tag>
            </li>
          ))}
        </ul>
      )
    }
    {
      project.links.length > 0 && (
        <p style="margin: var(--gap-sm) 0 0; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;">
          {project.links.map((link, i) => (
            <>
              {i > 0 && <span style="color: var(--paper-edge); margin: 0 0.5rem;">/</span>}
              <a href={link.href} style="text-decoration: none; color: var(--ink-soft);">
                {link.label}
              </a>
            </>
          ))}
        </p>
      )
    }
  </div>
  {
    hasThumb && (
      <div class="project-thumb" style="border-top: 1px solid var(--paper-edge); background: var(--paper);">
        <img
          src={project.thumbnail}
          alt={project.thumbnailAlt ?? project.name}
          loading="lazy"
          decoding="async"
          style="display: block; width: 100%; height: auto; max-height: 280px; object-fit: cover;"
        />
      </div>
    )
  }
</article>

<style>
  .project-card.has-thumb {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0;
    align-items: stretch;
  }
  .project-card.has-thumb .project-body {
    padding: var(--gap-lg);
  }
  .project-card.has-thumb .project-thumb {
    border-top: 0;
    border-left: 1px solid var(--paper-edge);
    display: flex;
    align-items: stretch;
  }
  .project-card.has-thumb .project-thumb img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
  @media (max-width: 640px) {
    .project-card.has-thumb {
      grid-template-columns: 1fr;
    }
    .project-card.has-thumb .project-thumb {
      border-left: 0;
      border-top: 1px solid var(--paper-edge);
    }
    .project-card.has-thumb .project-thumb img {
      max-height: 240px;
    }
  }
</style>
