---
import Tag from "./Tag.astro";
import type { Project } from "../consts";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const hasThumb = Boolean(project.thumbnail);
---

<article
  class:list={[
    "border border-[var(--paper-edge)] rounded-[var(--radius-md)] bg-[var(--paper-deep)] my-[var(--gap-md)] overflow-hidden",
    { "grid grid-cols-[1.4fr_1fr] items-stretch gap-0 max-[640px]:grid-cols-1": hasThumb },
  ]}
>
  <div class="p-[var(--gap-lg)]">
    <div>
      <h3 class="m-0 mb-[0.4rem] text-[var(--step-title)] text-[var(--ink)]">
        {project.name}
      </h3>
      <p class="label m-0 mb-[var(--gap-sm)] text-[var(--ink-mute)]">
        Role · {project.role}
      </p>
    </div>
    <p class="m-0 mb-[var(--gap-sm)] text-[var(--ink-soft)] text-[0.98rem] leading-[1.55]">
      {project.description}
    </p>
    {
      project.tech.length > 0 && (
        <ul class="m-0 mb-[var(--gap-sm)] flex list-none flex-wrap gap-[0.4rem] p-0">
          {project.tech.map((t) => (
            <li>
              <Tag>{t}</Tag>
            </li>
          ))}
        </ul>
      )
    }
    {
      project.links.length > 0 && (
        <p class="m-0 mt-[var(--gap-sm)] font-[var(--font-mono)] text-[0.78rem] tracking-[0.04em]">
          {project.links.map((link, i) => (
            <>
              {i > 0 && <span class="mx-[0.5rem] text-[var(--paper-edge)]">/</span>}
              <a href={link.href} class="text-[var(--ink-soft)] no-underline">
                {link.label}
              </a>
            </>
          ))}
        </p>
      )
    }
  </div>
  {
    hasThumb && (
      <div class="flex items-stretch border-t-0 border-l border-[var(--paper-edge)] bg-[var(--paper)] max-[640px]:border-t max-[640px]:border-l-0">
        <img
          src={project.thumbnail!.startsWith("/") ? `${import.meta.env.BASE_URL}${project.thumbnail!.replace(/^\//, "")}` : project.thumbnail}
          alt={project.thumbnailAlt ?? project.name}
          loading="lazy"
          decoding="async"
          class="block h-full max-h-none w-full rounded-none object-cover max-[640px]:h-auto max-[640px]:max-h-[240px]"
        />
      </div>
    )
  }
</article>
