---
import Tag from "./Tag.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"thoughts">;
}
const { entry } = Astro.props;
const { title, date, tags, description, thumbnail, thumbnailAlt } = entry.data;
const hasThumb = Boolean(thumbnail);

const mmdd = new Intl.DateTimeFormat("en-US", {
  month: "2-digit",
  day: "2-digit",
}).format(date);
const year = date.getFullYear();
---

<article
  class:list={["note-card", "my-4 min-w-0 border-b border-stone-300 py-2 lg:my-5 lg:py-3 xl:my-6", { "has-thumb": hasThumb }]}
>
  <div class="note-row flex min-w-0 flex-wrap items-baseline gap-4 lg:gap-8 xl:gap-12">
    <time
      datetime={date.toISOString()}
      class="min-w-16 shrink-0 font-mono text-xs tracking-wide text-stone-500 lg:min-w-20 lg:text-sm"
    >
      {year}.{mmdd}
    </time>
    <div class="note-text min-w-0 flex-1 break-words [&_a]:break-words [&_p]:break-words">
      <a
        href={`${import.meta.env.BASE_URL}thoughts/${entry.id}/`}
        class="font-serif text-lg text-stone-950 no-underline lg:text-xl xl:text-2xl"
      >
        {title}
      </a>
      {
        description && (
          <p class="mt-1 mb-0 text-sm leading-normal text-stone-500 lg:mt-2 lg:text-base lg:leading-relaxed">
            {description}
          </p>
        )
      }
      {
        tags.length > 0 && (
          <ul
            class="mt-2 mb-0 flex list-none flex-wrap gap-2 p-0"
          >
            {tags.map((t) => (
              <li>
                <Tag>{t}</Tag>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      hasThumb && (
        <a
          href={`${import.meta.env.BASE_URL}thoughts/${entry.id}/`}
          class="note-thumb-link block size-auto h-16 w-24 shrink-0 self-center overflow-hidden rounded-sm border border-stone-300 sm:mt-2 sm:h-36 sm:w-full lg:mt-0 lg:h-24 lg:w-36 xl:h-28 xl:w-44"
          aria-label={title}
        >
          <img
            src={thumbnail!.startsWith("/") ? `${import.meta.env.BASE_URL}${thumbnail!.replace(/^\//, "")}` : thumbnail}
            alt={thumbnailAlt ?? title}
            loading="lazy"
            decoding="async"
            class="block size-full object-cover"
          />
        </a>
      )
    }
  </div>
</article>
