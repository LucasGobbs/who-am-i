---
// Minimal section separator. variant: "line" | "dots" | "dotted" | "space".
interface Props {
  variant?: "line" | "dots" | "dotted" | "space";
  space?: "sm" | "md" | "lg";
}
const { variant = "line", space = "md" } = Astro.props;
const spaceClasses = {
  sm: "my-6",
  md: "my-12",
  lg: "my-16",
};
---

<div class={spaceClasses[space]} data-divider={variant}>
  {variant === "line" && (
    <hr class="m-0 border-0 border-t border-stone-300" />
  )}
  {variant === "dotted" && (
    <hr class="m-0 border-0 border-t border-dotted border-stone-400" />
  )}
  {variant === "dots" && (
    <div class="text-center font-mono text-sm leading-none tracking-widest text-stone-400">· · ·</div>
  )}
  {variant === "space" && <div></div>}
</div>
