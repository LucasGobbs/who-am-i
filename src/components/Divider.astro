---
// Minimal section separator. variant: "line" | "dots" | "dotted" | "space".
interface Props {
  variant?: "line" | "dots" | "dotted" | "space";
  space?: "sm" | "md" | "lg";
}
const { variant = "line", space = "md" } = Astro.props;
const spaceClasses = {
  sm: "my-[var(--gap-md)]",
  md: "my-[var(--gap-xl)]",
  lg: "my-[var(--gap-xxl)]",
};
---

<div class={spaceClasses[space]} data-divider={variant}>
  {variant === "line" && (
    <hr class="m-0 border-0 border-t border-[var(--paper-edge)]" />
  )}
  {variant === "dotted" && (
    <hr class="m-0 border-0 border-t border-dotted border-[var(--ink-faint)]" />
  )}
  {variant === "dots" && (
    <div class="text-center font-[family-name:var(--font-mono)] text-[0.8rem] leading-none tracking-[0.5em] text-[var(--ink-faint)]">· · ·</div>
  )}
  {variant === "space" && <div></div>}
</div>
