---
// Academic reference list. Place at the bottom of a thought.
// Pass `items` prop: array of { id, html }.
// Numbers are assigned in order (1, 2, 3...) and auto-filled into <Cite> links.
interface Item {
  id: string;
  html: string;
}
interface Props {
  items?: Item[];
}
const { items = [] } = Astro.props;
const numbered = items.map((it, i) => ({ ...it, n: i + 1 }));
---

<section
  class="references mt-16 border-t border-stone-300 pt-8 [&_a[href^='#ref-']]:text-orange-600 [&_a[href^='#ref-']]:no-underline [&_a[href^='#ref-']:hover]:underline"
  data-references
>
  <h2
    class="mb-6 mt-0 font-mono text-sm font-medium uppercase tracking-wider text-stone-500"
  >
    References
  </h2>
  <ol
    class="ref-list m-0 list-none p-0"
  >
    <slot />
    {numbered.map((it) => (
      <li
        id={`ref-${it.id}`}
        data-ref-id={it.id}
        data-ref-n={it.n}
        class="mb-4 flex gap-2 text-sm leading-relaxed text-stone-700"
      >
        <span
          class="ref-num min-w-6 shrink-0 font-mono text-sm text-stone-400"
        >[{it.n}]</span>
        <span set:html={it.html} />
      </li>
    ))}
  </ol>
</section>

<script is:inline>
  (() => {
    const run = () => {
      const refs = document.querySelectorAll("[data-ref-id]");
      if (!refs.length) return;
      const map = new Map();
      refs.forEach((li) => {
        map.set(li.dataset.refId, li.dataset.refN);
      });
      document.querySelectorAll(".cite[data-cite]").forEach((a) => {
        const id = a.getAttribute("data-cite");
        const manual = a.getAttribute("data-cite-n");
        const n = manual || map.get(id);
        if (n) a.textContent = `[${n}]`;
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
