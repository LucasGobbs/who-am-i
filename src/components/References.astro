---
// Academic reference list. Place at the bottom of a thought.
// Pass `items` prop: array of { id, html }.
// Numbers are assigned in order (1, 2, 3...) and auto-filled into <Cite> links.
interface Item {
  id: string;
  html: string;
}
interface Props {
  items?: Item[];
}
const { items = [] } = Astro.props;
const numbered = items.map((it, i) => ({ ...it, n: i + 1 }));
---

<section
  class="references mt-[var(--gap-xxl)] border-t border-[var(--paper-edge)] pt-[var(--gap-lg)] [&_a[href^='#ref-']]:text-[var(--accent)] [&_a[href^='#ref-']]:no-underline [&_a[href^='#ref-']:hover]:underline"
  data-references
>
  <h2
    class="mb-[var(--gap-md)] mt-0 font-[family-name:var(--font-mono)] text-[0.8rem] font-medium uppercase tracking-[0.06em] text-[var(--ink-mute)]"
  >
    References
  </h2>
  <ol
    class="ref-list m-0 list-none p-0"
  >
    <slot />
    {numbered.map((it) => (
      <li
        id={`ref-${it.id}`}
        data-ref-id={it.id}
        data-ref-n={it.n}
        class="mb-[var(--gap-sm)] flex gap-[0.6rem] text-[0.9rem] leading-[1.55] text-[var(--ink-soft)]"
      >
        <span
          class="ref-num min-w-[1.6rem] shrink-0 font-[family-name:var(--font-mono)] text-[0.82rem] text-[var(--ink-faint)]"
        >[{it.n}]</span>
        <span set:html={it.html} />
      </li>
    ))}
  </ol>
</section>

<script is:inline>
  (() => {
    const run = () => {
      const refs = document.querySelectorAll("[data-ref-id]");
      if (!refs.length) return;
      const map = new Map();
      refs.forEach((li) => {
        map.set(li.dataset.refId, li.dataset.refN);
      });
      document.querySelectorAll(".cite[data-cite]").forEach((a) => {
        const id = a.getAttribute("data-cite");
        const manual = a.getAttribute("data-cite-n");
        const n = manual || map.get(id);
        if (n) a.textContent = `[${n}]`;
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
